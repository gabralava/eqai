          <mxCell id="p1_edge_sap2_l2_down" edge="1" parent="1" source="p1_sap2_container" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6D28D9;strokeWidth=2.5;dashed=1;endArrow=classic;endFill=1;fontColor=#5B21B6;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.78;exitY=1;exitDx=0;exitDy=0;entryX=0.78;entryY=0;entryDx=0;entryDy=0;" target="p1_l2_container" value="EqTelemetryFrame (FFI Callback)">
