          <mxCell id="p1_edge_sap2_l3_up" edge="1" parent="1" source="p1_sap2_container" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0369A1;strokeWidth=2.5;endArrow=classic;endFill=1;fontColor=#0C4A6E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.22;exitY=0;exitDx=0;exitDy=0;entryX=0.22;entryY=1;entryDx=0;entryDy=0;" target="p1_l3_container" value="flutter_rust_bridge C-ABI Command">
