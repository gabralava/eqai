          </mxCell>
  
          <mxCell id="p3_e_and_hw" edge="1" parent="1" source="p3_l4_android" target="p3_l4_android_os" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#15803D;strokeWidth=2;startArrow=classic;endArrow=classic;fontSize=10;fontColor=#14532D;labelBackgroundColor=#F8FAFC;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" value="JNI / Broadcasts">
