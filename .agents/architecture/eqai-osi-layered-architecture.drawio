  <diagram id="osi-pdu-flow" name="4. OSI PDU Encapsulation &amp; Data Flow">
    <mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p4_title" value="&lt;b style=&quot;font-size:19px;&quot;&gt;4. OSI PDU Encapsulation &amp;amp; Vertical Data Flow (L1 &amp;rarr; L2 &amp;rarr; L3 &amp;rarr; L4 &amp;rarr; L1)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#334E68;&quot;&gt;Strict Adjacent-Layer Communication (L1 &amp;harr; L2 &amp;harr; L3 &amp;harr; L4) across SAP-1, SAP-2, and SAP-3 — 7-Band Parametric EQ &amp;amp; Universal Audio HAL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#0B4884;strokeWidth=2;fontColor=#052E56;align=left;spacingLeft=20;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="2440" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p4_col_hdr_layer" value="&lt;b style=&quot;font-size:13px;&quot;&gt;OSI Layer &amp;amp; SAP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#CBD5E1;&quot;&gt;L4 Top &amp;harr; L1 Bottom&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#0F172A;strokeWidth=1.5;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="45" y="100" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p4_col_hdr_a" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Scenario A (Upward ▲): Automatic AI &amp;amp; Semantic Sound Tuning&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#0F766E;&quot;&gt;&amp;quot;Add More Bass&amp;quot; / Headphone Selection (L1 &amp;rarr; L2 &amp;rarr; L3 &amp;rarr; L4)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6FFFA;strokeColor=#0F766E;strokeWidth=2;fontColor=#134E4A;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="295" y="100" width="690" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p4_col_hdr_b" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Scenario B (Upward ▲): Manual 7-Band Slider Adjustment&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#6B21A8;&quot;&gt;The OSI Caveat Flow — L2 Transparent Pass-Through Mux, 0 ms Fast-Path (L1 &amp;rarr; L2 &amp;rarr; L3 &amp;rarr; L4)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#6B46C1;strokeWidth=2;fontColor=#3B0764;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1025" y="100" width="690" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p4_col_hdr_c" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Scenario C (Downward ▼): Telemetry &amp;amp; Hardware Event Propagation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#9A3412;&quot;&gt;Headphone Plug / Bluetooth &amp;amp; 60fps UI Curve Sync (L4 &amp;rarr; L3 &amp;rarr; L2 &amp;rarr; L1)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C2410C;strokeWidth=2;fontColor=#7C2D12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1755" y="100" width="690" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p4_boundary_l4" value="&lt;b&gt;Layer 4 (TOP-MOST): OS Audio Subsystem Layer — Swappable Platform Backends (Android MVP / iOS / Windows / Linux)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeWidth=2;fillColor=#F2FAF5;strokeColor=#1E8449;fontColor=#0E4725;verticalAlign=top;align=left;spacingLeft=16;spacingTop=6;fontSize=13;container=0;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="30" y="170" width="2440" height="215" as="geometry" />
        </mxCell>
        <mxCell id="p4_boundary_l3" value="&lt;b&gt;Layer 3: Rust Mathematical &amp;amp; DSP Engine Layer (libeqai_math — OS-Agnostic Pure Rust Core)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeWidth=2;fillColor=#FFF7F0;strokeColor=#B45309;fontColor=#5C2400;verticalAlign=top;align=left;spacingLeft=16;spacingTop=6;fontSize=13;container=0;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="30" y="510" width="2440" height="225" as="geometry" />
        </mxCell>
        <mxCell id="p4_boundary_l2" value="&lt;b&gt;Layer 2: On-Device AI Model &amp;amp; Pass-Through Mux Layer (Dart Background Isolate + INT8 .tflite)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeWidth=2;fillColor=#F6F3FC;strokeColor=#6B46C1;fontColor=#2E1A5E;verticalAlign=top;align=left;spacingLeft=16;spacingTop=6;fontSize=13;container=0;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="30" y="860" width="2440" height="225" as="geometry" />
        </mxCell>
        <mxCell id="p4_boundary_l1" value="&lt;b&gt;Layer 1 (BOTTOM-MOST): Flutter Thin UI Shell &amp;amp; Local Storage (Riverpod + CustomPainter + SQLite)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeWidth=2;fillColor=#F2F7FC;strokeColor=#1E6091;fontColor=#0B3954;verticalAlign=top;align=left;spacingLeft=16;spacingTop=6;fontSize=13;container=0;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="30" y="1210" width="2440" height="225" as="geometry" />
        </mxCell>
        <mxCell id="p4_sap3_line" value="" style="endArrow=none;dashed=1;dashPattern=6 4;strokeWidth=2;strokeColor=#475569;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="265" y="447" as="sourcePoint" />
            <mxPoint x="2470" y="447" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p4_sap2_line" value="" style="endArrow=none;dashed=1;dashPattern=6 4;strokeWidth=2;strokeColor=#475569;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="265" y="797" as="sourcePoint" />
            <mxPoint x="2470" y="797" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p4_sap1_line" value="" style="endArrow=none;dashed=1;dashPattern=6 4;strokeWidth=2;strokeColor=#475569;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="265" y="1147" as="sourcePoint" />
            <mxPoint x="2470" y="1147" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p4_lbl_l4" value="&lt;b style=&quot;font-size:13px;&quot;&gt;LAYER 4 (TOP)&lt;/b&gt;&lt;br&gt;&lt;b&gt;OS Audio Subsystem&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;Android DynamicsProcessing (MVP), iOS AUv3, Windows APO, Linux PipeWire&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E8449;strokeColor=#0E4725;strokeWidth=1.5;fontColor=#FFFFFF;spacing=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="200" width="220" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p4_a4" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Step A4: Apply 7-Band EQ &amp;amp; Preamp to System Audio&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#14532D;&quot;&gt;[L4 OS Audio Backend — Sink]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Receives &lt;b&gt;&lt;code&gt;L3_HalStatePDU&lt;/code&gt;&lt;/b&gt; via &lt;b&gt;SAP-3&lt;/b&gt;. Applies 7-band equalization &amp;amp; &lt;code&gt;-4.2 dB&lt;/code&gt; preamp:&lt;br&gt;&amp;bull; &lt;b&gt;Android MVP:&lt;/b&gt; &lt;code&gt;jni-rs &amp;rarr; DynamicsProcessing(sessionId=0)&lt;/code&gt;&lt;br&gt;&amp;bull; &lt;b&gt;iOS / Windows / Linux:&lt;/b&gt; Atomic coefficient swap in real-time PCM callback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4EFDF;strokeColor=#1E8449;strokeWidth=1.5;fontColor=#0B3B1E;align=left;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="320" y="200" width="640" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p4_b4" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Step B4: Immediate OS Backend Commit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#14532D;&quot;&gt;[L4 OS Audio Backend — Sink]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Receives updated &lt;b&gt;&lt;code&gt;L3_HalStatePDU&lt;/code&gt;&lt;/b&gt; via &lt;b&gt;SAP-3&lt;/b&gt;.&lt;br&gt;Applies updated Band #3 parameters/coefficients immediately to the active OS audio backend (&lt;code&gt;DynamicsProcessing(sessionId=0)&lt;/code&gt; on Android MVP or atomic PCM filter swap on iOS/Windows/Linux)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4EFDF;strokeColor=#1E8449;strokeWidth=1.5;fontColor=#0B3B1E;align=left;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="1050" y="200" width="640" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p4_c1" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Step C1: Hardware Plug / Bluetooth Event &amp;amp; Frame Commit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#14532D;&quot;&gt;[L4 OS Audio Backend — Event Source]&lt;/font&gt;&lt;br&gt;&lt;br&gt;User plugs in wired headphones or connects Bluetooth headset (&lt;code&gt;&amp;quot;Sony WH-1000XM5&amp;quot;&lt;/code&gt;), or L4 confirms audio frame commit.&lt;br&gt;L4 emits &lt;b&gt;&lt;code&gt;L4_HardwareEventSDU&lt;/code&gt;&lt;/b&gt; &lt;b&gt;DOWN&lt;/b&gt; across &lt;b&gt;SAP-3&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4EFDF;strokeColor=#1E8449;strokeWidth=1.5;fontColor=#0B3B1E;align=left;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="1780" y="200" width="640" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p4_sap3_badge" value="&lt;b style=&quot;font-size:12px;&quot;&gt;SAP-3&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;UniversalSystemAudioHal&lt;br&gt;(L3 &amp;harr; L4 Contract)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#334155;strokeColor=#0F172A;strokeWidth=1.5;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="45" y="412" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4_pdu_a3" value="&lt;b style=&quot;font-size:11.5px;color:#0F766E;&quot;&gt;&amp;#9650; UP across SAP-3 (UniversalSystemAudioHal)&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;code style=&quot;font-size:11.5px;&quot;&gt;L3_HalStatePDU { bands_7, coeffs_7, preamp_db: -4.2 }&lt;/code&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="340" y="412" width="600" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4_pdu_b3" value="&lt;b style=&quot;font-size:11.5px;color:#0F766E;&quot;&gt;&amp;#9650; UP across SAP-3 (UniversalSystemAudioHal)&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;code style=&quot;font-size:11.5px;&quot;&gt;L3_HalStatePDU { bands_7, coeffs_7, preamp_db }&lt;/code&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1070" y="412" width="600" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4_sdu_c1" value="&lt;b style=&quot;font-size:11.5px;color:#C2410C;&quot;&gt;&amp;#9660; DOWN across SAP-3 (HAL Device Event)&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;code style=&quot;font-size:11.5px;&quot;&gt;L4_HardwareEventSDU { device_name: &amp;quot;Sony WH-1000XM5&amp;quot;, sample_rate: 48000 }&lt;/code&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#C2410C;strokeWidth=2;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1800" y="412" width="600" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4_lbl_l3" value="&lt;b style=&quot;font-size:13px;&quot;&gt;LAYER 3&lt;/b&gt;&lt;br&gt;&lt;b&gt;Rust DSP Engine&lt;/b&gt;&lt;br&gt;&lt;code&gt;libeqai_math&lt;/code&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;RBJ biquads, 512-pt FR curve, crossfade, auto-preamp guard&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B45309;strokeColor=#78350F;strokeWidth=1.5;fontColor=#FFFFFF;spacing=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="540" width="220" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p4_a3" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Step A3: Compute RBJ Coeffs, 512-pt FR &amp;amp; Auto-Preamp&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#7C2D12;&quot;&gt;[L3 Rust Mathematical Engine]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Receives &lt;b&gt;&lt;code&gt;L2_EqFramePDU&lt;/code&gt;&lt;/b&gt; via &lt;b&gt;SAP-2&lt;/b&gt;. Computes 7 RBJ biquad coefficient sets (&lt;code&gt;[BiquadCoeffs; 7]&lt;/code&gt;), 512-pt composite FR curve (dB), 50 ms crossfade interpolation frames, and safe negative auto-preamp gain (&lt;code&gt;-4.2 dB&lt;/code&gt;).&lt;br&gt;Encapsulates into &lt;b&gt;&lt;code&gt;L3_HalStatePDU&lt;/code&gt;&lt;/b&gt; and sends UP across &lt;b&gt;SAP-3&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD0;strokeColor=#B45309;strokeWidth=1.5;fontColor=#4D2600;align=left;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="320" y="540" width="640" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p4_b3" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Step B3: Recompute Band Coeffs, FR Curve &amp;amp; Auto-Preamp&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#7C2D12;&quot;&gt;[L3 Rust Mathematical Engine]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Receives &lt;b&gt;&lt;code&gt;L2_EqFramePDU (crossfade_ms: 15)&lt;/code&gt;&lt;/b&gt; via &lt;b&gt;SAP-2&lt;/b&gt;. Recomputes RBJ biquad coefficients for the modified band (&lt;code&gt;125 Hz, +3.5 dB, Q=1.41&lt;/code&gt;), evaluates the new 512-pt composite FR curve &amp;amp; auto-preamp.&lt;br&gt;Pushes &lt;b&gt;&lt;code&gt;L3_HalStatePDU&lt;/code&gt;&lt;/b&gt; UP across &lt;b&gt;SAP-3&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD0;strokeColor=#B45309;strokeWidth=1.5;fontColor=#4D2600;align=left;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="1050" y="540" width="640" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p4_c2" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Step C2: Recalculate Sample-Rate Coeffs &amp;amp; Telemetry SDU&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#7C2D12;&quot;&gt;[L3 Rust Mathematical Engine]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Receives &lt;b&gt;&lt;code&gt;L4_HardwareEventSDU&lt;/code&gt;&lt;/b&gt; via &lt;b&gt;SAP-3&lt;/b&gt;. Updates internal sample rate (&lt;code&gt;fs = 48000 Hz&lt;/code&gt;), recalculates frequency-dependent biquad coefficients (&lt;code&gt;&amp;omega;&lt;sub&gt;0&lt;/sub&gt; = 2&amp;pi; f&lt;sub&gt;0&lt;/sub&gt; / f&lt;sub&gt;s&lt;/sub&gt;&lt;/code&gt;), packages &lt;b&gt;&lt;code&gt;L3_TelemetrySDU&lt;/code&gt;&lt;/b&gt;, and returns it DOWN across &lt;b&gt;SAP-2&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD0;strokeColor=#B45309;strokeWidth=1.5;fontColor=#4D2600;align=left;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="1780" y="540" width="640" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p4_sap2_badge" value="&lt;b style=&quot;font-size:12px;&quot;&gt;SAP-2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;flutter_rust_bridge&lt;br&gt;(L2 &amp;harr; L3 FFI)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#334155;strokeColor=#0F172A;strokeWidth=1.5;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="45" y="762" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4_pdu_a2" value="&lt;b style=&quot;font-size:11.5px;color:#0F766E;&quot;&gt;&amp;#9650; UP across SAP-2 (flutter_rust_bridge)&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;code style=&quot;font-size:11.5px;&quot;&gt;L2_EqFramePDU { bands: [BiquadBandSpec; 7], crossfade_ms: 50 }&lt;/code&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="340" y="762" width="600" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4_pdu_b2" value="&lt;b style=&quot;font-size:11.5px;color:#0F766E;&quot;&gt;&amp;#9650; UP across SAP-2 (flutter_rust_bridge)&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;code style=&quot;font-size:11.5px;&quot;&gt;L2_EqFramePDU { bands: [BiquadBandSpec; 7], crossfade_ms: 15 }&lt;/code&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1070" y="762" width="600" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4_sdu_c2" value="&lt;b style=&quot;font-size:11.5px;color:#C2410C;&quot;&gt;&amp;#9660; DOWN across SAP-2 (flutter_rust_bridge)&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;code style=&quot;font-size:11px;&quot;&gt;L3_TelemetrySDU { eq_curve_512_db, compensated_fr_512_db, preamp_db, device_event }&lt;/code&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#C2410C;strokeWidth=2;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1800" y="762" width="600" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4_lbl_l2" value="&lt;b style=&quot;font-size:13px;&quot;&gt;LAYER 2&lt;/b&gt;&lt;br&gt;&lt;b&gt;AI Model Layer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;(INT8 TFLite + Mux)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;Neural EQ inference OR 0 ms pass-through mux for manual sliders&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5A3E9E;strokeColor=#2E1A5E;strokeWidth=1.5;fontColor=#FFFFFF;spacing=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="890" width="220" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p4_a2" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Step A2: Execute INT8 .tflite Neural Inference&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4C1D95;&quot;&gt;[L2 On-Device AI Model — TFLite Isolate]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Receives &lt;b&gt;&lt;code&gt;L1_IntentPDU&lt;/code&gt;&lt;/b&gt; via &lt;b&gt;SAP-1&lt;/b&gt;. Runs quantized INT8 inference (&lt;code&gt;base_eq.tflite&lt;/code&gt; / &lt;code&gt;abstract_tuning.tflite&lt;/code&gt;) to predict 7 optimal biquad bands (&lt;code&gt;21 floats&lt;/code&gt;, 7&amp;times;3).&lt;br&gt;Encapsulates into &lt;b&gt;&lt;code&gt;L2_EqFramePDU (crossfade_ms: 50)&lt;/code&gt;&lt;/b&gt; and sends UP across &lt;b&gt;SAP-2&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9D8FD;strokeColor=#6B46C1;strokeWidth=1.5;fontColor=#2D1458;align=left;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="320" y="890" width="640" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p4_b2" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Step B2: Transparent Pass-Through Mux (The OSI Caveat)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4C1D95;&quot;&gt;[L2 Layer-Adjacency Mux — 0 ms Bypass]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Receives &lt;code&gt;ManualOverride&lt;/code&gt; via &lt;b&gt;SAP-1&lt;/b&gt;. &lt;b&gt;Bypasses TFLite neural inference (0 ms fast-path)&lt;/b&gt; while enforcing strict OSI layer adjacency (L1 never jumps directly to L3).&lt;br&gt;Forwards &lt;b&gt;&lt;code&gt;L2_EqFramePDU (crossfade_ms: 15)&lt;/code&gt;&lt;/b&gt; UP across &lt;b&gt;SAP-2&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDD6FE;strokeColor=#5B21B6;strokeWidth=2.5;fontColor=#2D1458;align=left;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="1050" y="890" width="640" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p4_c3" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Step C3: Update Band Context &amp;amp; Relay UI State SDU&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4C1D95;&quot;&gt;[L2 On-Device AI Model — State Relay]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Receives &lt;b&gt;&lt;code&gt;L3_TelemetrySDU&lt;/code&gt;&lt;/b&gt; via &lt;b&gt;SAP-2&lt;/b&gt;. Updates cached active 7-band context in the background worker.&lt;br&gt;Relays &lt;b&gt;&lt;code&gt;L2_UiStateSDU&lt;/code&gt;&lt;/b&gt; DOWN across &lt;b&gt;SAP-1&lt;/b&gt; to the main Dart Isolate." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9D8FD;strokeColor=#6B46C1;strokeWidth=1.5;fontColor=#2D1458;align=left;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="1780" y="890" width="640" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p4_sap1_badge" value="&lt;b style=&quot;font-size:12px;&quot;&gt;SAP-1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;Dart Isolate Port / Msg&lt;br&gt;(L1 &amp;harr; L2 Channel)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#334155;strokeColor=#0F172A;strokeWidth=1.5;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="45" y="1112" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4_pdu_a1" value="&lt;b style=&quot;font-size:11.5px;color:#0F766E;&quot;&gt;&amp;#9650; UP across SAP-1 (Dart Isolate Port)&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;code style=&quot;font-size:11.5px;&quot;&gt;L1_IntentPDU { mode: SemanticTuning, vec4: [+0.6, 0, 0, 0], fr512 }&lt;/code&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="340" y="1112" width="600" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4_pdu_b1" value="&lt;b style=&quot;font-size:11.5px;color:#0F766E;&quot;&gt;&amp;#9650; UP across SAP-1 (Dart Isolate Port)&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;code style=&quot;font-size:11.5px;&quot;&gt;L1_IntentPDU { mode: ManualOverride, bands_7 }&lt;/code&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1070" y="1112" width="600" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4_sdu_c3" value="&lt;b style=&quot;font-size:11.5px;color:#C2410C;&quot;&gt;&amp;#9660; DOWN across SAP-1 (Main Dart Isolate)&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;code style=&quot;font-size:11px;&quot;&gt;L2_UiStateSDU { eq_curve_512_db, compensated_fr_512_db, preamp_db, device_event }&lt;/code&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#C2410C;strokeWidth=2;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1800" y="1112" width="600" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4_lbl_l1" value="&lt;b style=&quot;font-size:13px;&quot;&gt;LAYER 1 (BOTTOM)&lt;/b&gt;&lt;br&gt;&lt;b&gt;Flutter Thin UI Shell&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;Riverpod, 60fps CustomPainter, SQLite FTS5 autoeq.db &amp;amp; user profiles&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;strokeWidth=1.5;fontColor=#FFFFFF;spacing=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="1240" width="220" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p4_a1" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Step A1: Headphone Selection / &amp;quot;More Bass&amp;quot; Slider&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#1E3A8A;&quot;&gt;[L1 Flutter Presentation &amp;amp; SQLite AutoEQ Repo]&lt;/font&gt;&lt;br&gt;&lt;br&gt;User selects headphone model (loads &lt;code&gt;512-pt FLOAT32 BLOB&lt;/code&gt; from SQLite &lt;code&gt;autoeq.db&lt;/code&gt;) or moves &lt;code&gt;&amp;quot;More Bass&amp;quot;&lt;/code&gt; semantic slider.&lt;br&gt;L1 packages &lt;b&gt;&lt;code&gt;L1_IntentPDU&lt;/code&gt;&lt;/b&gt; and sends UP across &lt;b&gt;SAP-1&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6EAF8;strokeColor=#1E6091;strokeWidth=1.5;fontColor=#0B3954;align=left;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="320" y="1240" width="640" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p4_b1" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Step B1: Drag Band #3 Handle on CustomPainter Chart&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#1E3A8A;&quot;&gt;[L1 Flutter CustomPainter &amp;amp; Riverpod]&lt;/font&gt;&lt;br&gt;&lt;br&gt;User drags Band #3 handle on the &lt;code&gt;CustomPainter&lt;/code&gt; FR chart (&lt;code&gt;125 Hz, +3.5 dB, Q=1.41&lt;/code&gt;).&lt;br&gt;L1 packages &lt;b&gt;&lt;code&gt;L1_IntentPDU { mode: ManualOverride, bands_7 }&lt;/code&gt;&lt;/b&gt; and sends UP across &lt;b&gt;SAP-1&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6EAF8;strokeColor=#1E6091;strokeWidth=1.5;fontColor=#0B3954;align=left;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="1050" y="1240" width="640" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p4_c4" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Step C4: Riverpod Update, 60fps Redraw &amp;amp; Auto-Profile Load&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#1E3A8A;&quot;&gt;[L1 Flutter UI &amp;amp; ProfileRepository — Sink]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Receives &lt;b&gt;&lt;code&gt;L2_UiStateSDU&lt;/code&gt;&lt;/b&gt; via &lt;b&gt;SAP-1&lt;/b&gt;. &lt;code&gt;Riverpod&lt;/code&gt; state updates; &lt;code&gt;CustomPainter&lt;/code&gt; redraws the 512-pt curves at 60fps, or &lt;code&gt;ProfileRepository&lt;/code&gt; auto-loads the saved SQLite profile for &lt;code&gt;&amp;quot;Sony WH-1000XM5&amp;quot;&lt;/code&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6EAF8;strokeColor=#1E6091;strokeWidth=1.5;fontColor=#0B3954;align=left;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="1780" y="1240" width="640" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p4_legend" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Legend &amp;amp; OSI PDU Architectural Invariants&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#1E8449&quot; style=&quot;font-size:13px;&quot;&gt;&amp;#9632;&lt;/font&gt; &lt;b&gt;Layer 4 (Top):&lt;/b&gt; OS Audio Subsystem (Swappable Platform Backend: Android DynamicsProcessing MVP / iOS AUv3 / Windows APO / Linux PipeWire) &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#B45309&quot; style=&quot;font-size:13px;&quot;&gt;&amp;#9632;&lt;/font&gt; &lt;b&gt;Layer 3:&lt;/b&gt; Rust Mathematical &amp;amp; DSP Engine (&lt;code&gt;libeqai_math&lt;/code&gt;)&lt;br&gt;&lt;font color=&quot;#6B46C1&quot; style=&quot;font-size:13px;&quot;&gt;&amp;#9632;&lt;/font&gt; &lt;b&gt;Layer 2:&lt;/b&gt; On-Device AI Model (INT8 TFLite + 0 ms Pass-Through Mux) &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#1168BD&quot; style=&quot;font-size:13px;&quot;&gt;&amp;#9632;&lt;/font&gt; &lt;b&gt;Layer 1 (Bottom):&lt;/b&gt; Flutter Thin UI Shell (Riverpod + CustomPainter + SQLite)&lt;br&gt;&lt;font color=&quot;#0F766E&quot; style=&quot;font-size:13px;&quot;&gt;&lt;b&gt;&amp;#9650; PDU (Upward L1&amp;rarr;L4):&lt;/b&gt;&lt;/font&gt; Control encapsulation (&lt;code&gt;L1_IntentPDU &amp;rarr; L2_EqFramePDU &amp;rarr; L3_HalStatePDU&lt;/code&gt;) &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#C2410C&quot; style=&quot;font-size:13px;&quot;&gt;&lt;b&gt;&amp;#9660; SDU (Downward L4&amp;rarr;L1):&lt;/b&gt;&lt;/font&gt; Hardware event &amp;amp; 512-pt telemetry propagation (&lt;code&gt;L4_HardwareEventSDU &amp;rarr; L3_TelemetrySDU &amp;rarr; L2_UiStateSDU&lt;/code&gt;)&lt;br&gt;&lt;br&gt;&lt;b&gt;Strict Layer Adjacency Invariant:&lt;/b&gt; Layers NEVER skip an intermediate layer. Manual 7-band adjustments (Scenario B) still cross &lt;b&gt;SAP-1&lt;/b&gt; into Layer 2, where the &lt;b&gt;Transparent Pass-Through Mux&lt;/b&gt; skips neural inference in &lt;code&gt;0 ms&lt;/code&gt; and forwards &lt;code&gt;L2_EqFramePDU&lt;/code&gt; across &lt;b&gt;SAP-2&lt;/b&gt; to Layer 3." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=18;spacingTop=12;spacingRight=16;fontColor=#1E293B;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="30" y="1465" width="2440" height="205" as="geometry" />
        </mxCell>
        <mxCell id="p4_e_a1_pdu" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F766E;strokeWidth=2.5;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4_a1" target="p4_pdu_a1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4_e_pdu_a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F766E;strokeWidth=2.5;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4_pdu_a1" target="p4_a2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4_e_a2_pdu" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F766E;strokeWidth=2.5;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4_a2" target="p4_pdu_a2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4_e_pdu_a3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F766E;strokeWidth=2.5;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4_pdu_a2" target="p4_a3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4_e_a3_pdu" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F766E;strokeWidth=2.5;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4_a3" target="p4_pdu_a3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4_e_pdu_a4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F766E;strokeWidth=2.5;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4_pdu_a3" target="p4_a4">
