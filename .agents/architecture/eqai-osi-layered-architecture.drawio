<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="osi-stack" name="1. OSI Hierarchical Stack (L1-L4)">
      <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1600" math="0" shadow="0">
        <root>
          <mxCell id="0" />
          <mxCell id="1" parent="0" />
          <mxCell id="p1_title_banner" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#334155;strokeWidth=2;fontColor=#F8FAFC;align=left;spacingLeft=22;verticalAlign=middle;" value="&lt;b style=&quot;font-size:20px;&quot;&gt;EQAI — OSI-Style 4-Layer Hierarchical Architecture (1. OSI Hierarchical Stack: L1–L4)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#CBD5E1;&quot;&gt;Strict Adjacent-Layer Encapsulation (L1 &amp;lt;-&amp;gt; L2 &amp;lt;-&amp;gt; L3 &amp;lt;-&amp;gt; L4) via Formal Service Access Points (SAP-1, SAP-2, SAP-3) — OS-Agnostic Core &amp;amp; Swappable Layer-4 Audio Backends&lt;/span&gt;" vertex="1">
            <mxGeometry height="70" width="2140" x="30" y="20" as="geometry" />
          </mxCell>
          <mxCell id="p1_l4_container" parent="1" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2.5;fontColor=#78350F;verticalAlign=top;align=left;spacingLeft=18;spacingTop=10;arcSize=4;" value="&lt;b style=&quot;font-size:15px;&quot;&gt;LAYER 4 (TOP) — OS Audio Subsystem Layer (Swappable Platform Backends)&lt;/b&gt; &amp;nbsp;&lt;span style=&quot;font-size:12px;color:#92400E;&quot;&gt;| Only OS-specific layer: swapping backend requires ZERO changes to L1, L2, or L3&lt;/span&gt;" vertex="1">
            <mxGeometry height="235" width="1490" x="30" y="110" as="geometry" />
          </mxCell>
          <mxCell id="p1_l4_android" parent="p1_l4_container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#065F46;strokeColor=#064E3B;strokeWidth=2;fontColor=#FFFFFF;arcSize=8;spacing=10;verticalAlign=middle;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Active MVP: Android Audio Backend&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#A7F3D0;&quot;&gt;[L4 Platform Driver: Android JNI (jni-rs)]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Applies 7-band EQ &amp;amp; preamp via &lt;b&gt;android.media.audiofx.DynamicsProcessing&lt;/b&gt; on global &lt;b&gt;sessionId = 0&lt;/b&gt;.&lt;/span&gt;" vertex="1">
            <mxGeometry height="170" width="350" x="20" y="48" as="geometry" />
          </mxCell>
          <mxCell id="p1_l4_ios" parent="p1_l4_container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.8;dashed=1;fontColor=#1E293B;arcSize=8;spacing=10;verticalAlign=middle;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Future: iOS Audio Backend&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;[L4 Platform Driver: iOS CoreAudio C-ABI]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Plug-compatible via SAP-3: &lt;b&gt;AUv3 Audio Unit Extension / AVAudioEngine&lt;/b&gt; pulling DSP PCM frames from L3.&lt;/span&gt;" vertex="1">
            <mxGeometry height="170" width="350" x="387" y="48" as="geometry" />
          </mxCell>
          <mxCell id="p1_l4_windows" parent="p1_l4_container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.8;dashed=1;fontColor=#1E293B;arcSize=8;spacing=10;verticalAlign=middle;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Future: Windows Audio Backend&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;[L4 Platform Driver: Windows COM / C-ABI]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Plug-compatible via SAP-3: &lt;b&gt;Windows APO / WASAPI Loopback &amp;amp; Endpoint&lt;/b&gt; audio processing object.&lt;/span&gt;" vertex="1">
            <mxGeometry height="170" width="350" x="754" y="48" as="geometry" />
          </mxCell>
          <mxCell id="p1_l4_linux" parent="p1_l4_container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.8;dashed=1;fontColor=#1E293B;arcSize=8;spacing=10;verticalAlign=middle;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Future: Linux Audio Backend&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;[L4 Platform Driver: Linux C-ABI / SPA]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Plug-compatible via SAP-3: &lt;b&gt;PipeWire Filter-Chain / ALSA Plugin&lt;/b&gt; pulling real-time L3 PCM filtering.&lt;/span&gt;" vertex="1">
            <mxGeometry height="170" width="350" x="1120" y="48" as="geometry" />
          </mxCell>
          <mxCell id="p1_sap3_container" parent="1" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#CCFBF1;strokeColor=#0F766E;strokeWidth=2.5;fontColor=#134E4A;verticalAlign=top;align=left;spacingLeft=18;spacingTop=8;arcSize=6;" value="&lt;b style=&quot;font-size:14px;&quot;&gt;SAP-3: Universal OS Audio HAL Interface (trait UniversalAudioBackend / eqai_hal_vtable)&lt;/b&gt;" vertex="1">
            <mxGeometry height="130" width="1490" x="30" y="395" as="geometry" />
          </mxCell>
          <mxCell id="p1_sap3_up" parent="p1_sap3_container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;strokeWidth=1.5;fontColor=#0F172A;arcSize=6;spacing=6;align=left;spacingLeft=10;" value="&lt;b style=&quot;font-size:11px;color:#0F766E;&quot;&gt;Upward Control Contract (L3 -&amp;gt; L4):&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;font-size:10.5px;&quot;&gt;apply_biquad_cascade(bands: &amp;amp;[BiquadBandSpec; 7], coeffs: &amp;amp;[BiquadCoeffs; 7], preamp_db: f32, enabled: bool) -&amp;gt; HalResult&amp;lt;()&amp;gt;&lt;/span&gt;" vertex="1">
            <mxGeometry height="78" width="475" x="20" y="38" as="geometry" />
          </mxCell>
          <mxCell id="p1_sap3_pcm" parent="p1_sap3_container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;fontColor=#0F172A;arcSize=6;spacing=6;align=left;spacingLeft=10;" value="&lt;b style=&quot;font-size:11px;color:#B45309;&quot;&gt;Bidirectional Real-Time DSP Stream Contract (L4 &amp;lt;-&amp;gt; L3):&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;font-size:10.5px;&quot;&gt;process_pcm_frames(pcm_f32: &amp;amp;mut [f32], frames: usize, channels: u16, sample_rate: u32)&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;(iOS / Windows / Linux buffer pull)&lt;/span&gt;" vertex="1">
            <mxGeometry height="78" width="505" x="515" y="38" as="geometry" />
          </mxCell>
          <mxCell id="p1_sap3_down" parent="p1_sap3_container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.5;fontColor=#0F172A;arcSize=6;spacing=6;align=left;spacingLeft=10;" value="&lt;b style=&quot;font-size:11px;color:#6D28D9;&quot;&gt;Downward Hardware Event Callback (L4 -&amp;gt; L3):&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;font-size:10.5px;&quot;&gt;on_audio_device_changed(device_name: &amp;amp;str, transport: AudioTransportType, sample_rate: u32)&lt;/span&gt;" vertex="1">
            <mxGeometry height="78" width="430" x="1040" y="38" as="geometry" />
          </mxCell>
          <mxCell id="p1_l3_container" parent="1" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FFEDD5;strokeColor=#C2410C;strokeWidth=2.5;fontColor=#7C2D12;verticalAlign=top;align=left;spacingLeft=18;spacingTop=10;arcSize=4;" value="&lt;b style=&quot;font-size:15px;&quot;&gt;LAYER 3 — Rust Mathematical &amp;amp; DSP Engine Layer (libeqai_math)&lt;/b&gt; &amp;nbsp;&lt;span style=&quot;font-size:12px;color:#9A3412;&quot;&gt;| 100% OS-Agnostic Pure Rust Core (Zero platform imports)&lt;/span&gt;" vertex="1">
            <mxGeometry height="195" width="1490" x="30" y="575" as="geometry" />
          </mxCell>
          <mxCell id="p1_l3_rbj" parent="p1_l3_container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B45309;strokeColor=#78350F;fontColor=#FFFFFF;arcSize=8;spacing=10;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;7-Band RBJ Biquad Coefficient Engine&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Computes normalized &lt;b&gt;b0, b1, b2, a1, a2&lt;/b&gt; coefficients (f64) for &lt;b&gt;Peak Bell&lt;/b&gt;, &lt;b&gt;Low Shelf&lt;/b&gt;, and &lt;b&gt;High Shelf&lt;/b&gt; filters from band specs &amp;amp; sample rate.&lt;/span&gt;" vertex="1">
            <mxGeometry height="130" width="350" x="20" y="48" as="geometry" />
          </mxCell>
          <mxCell id="p1_l3_df2t" parent="p1_l3_container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B45309;strokeColor=#78350F;fontColor=#FFFFFF;arcSize=8;spacing=10;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Direct Form II Transposed PCM Filter Cascade&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;7-band real-time sample processor for buffer-based OSes (iOS, Windows, Linux) invoked via SAP-3 &lt;b&gt;process_pcm_frames&lt;/b&gt;.&lt;/span&gt;" vertex="1">
            <mxGeometry height="130" width="350" x="387" y="48" as="geometry" />
          </mxCell>
          <mxCell id="p1_l3_fr512" parent="p1_l3_container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B45309;strokeColor=#78350F;fontColor=#FFFFFF;arcSize=8;spacing=10;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;512-Point Logarithmic FR &amp;amp; Phase Evaluator&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Evaluates composite transfer function across &lt;b&gt;20 Hz – 20 kHz&lt;/b&gt; (512 log-spaced bins in dB) &amp;amp; compensated headphone curve.&lt;/span&gt;" vertex="1">
            <mxGeometry height="130" width="350" x="754" y="48" as="geometry" />
          </mxCell>
          <mxCell id="p1_l3_guard" parent="p1_l3_container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B45309;strokeColor=#78350F;fontColor=#FFFFFF;arcSize=8;spacing=10;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Crossfade Interpolator &amp;amp; Auto-Preamp Clipping Guard&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Smooth glitch-free parameter ramping (&lt;b&gt;crossfade_ms&lt;/b&gt;) and negative peak-gain headroom guard to prevent digital clipping.&lt;/span&gt;" vertex="1">
            <mxGeometry height="130" width="350" x="1120" y="48" as="geometry" />
          </mxCell>
          <mxCell id="p1_sap2_container" parent="1" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#E0E7FF;strokeColor=#4338CA;strokeWidth=2.5;fontColor=#1E1B4B;verticalAlign=top;align=left;spacingLeft=18;spacingTop=8;arcSize=6;" value="&lt;b style=&quot;font-size:14px;&quot;&gt;SAP-2: Universal EQ Engine FFI Interface (flutter_rust_bridge / C-ABI)&lt;/b&gt;" vertex="1">
            <mxGeometry height="120" width="1490" x="30" y="820" as="geometry" />
          </mxCell>
          <mxCell id="p1_sap2_up" parent="p1_sap2_container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4F46E5;strokeWidth=1.5;fontColor=#0F172A;arcSize=6;spacing=6;align=left;spacingLeft=12;" value="&lt;b style=&quot;font-size:11px;color:#3730A3;&quot;&gt;Upward Command PDU (L2 -&amp;gt; L3):&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;font-size:10.5px;&quot;&gt;submit_eq_frame(frame: EqParameterFrame { bands: [BiquadBandSpec; 7], preamp_override_db: Option&amp;lt;f32&amp;gt;, crossfade_ms: u32, bypass: bool })&lt;/span&gt;" vertex="1">
            <mxGeometry height="70" width="715" x="20" y="36" as="geometry" />
          </mxCell>
          <mxCell id="p1_sap2_down" parent="p1_sap2_container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.5;fontColor=#0F172A;arcSize=6;spacing=6;align=left;spacingLeft=12;" value="&lt;b style=&quot;font-size:11px;color:#6D28D9;&quot;&gt;Downward Telemetry SDU (L3 -&amp;gt; L2):&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;font-size:10.5px;&quot;&gt;EqTelemetryFrame { coeffs: [BiquadCoeffs; 7], eq_fr_512_db: [f32; 512], compensated_fr_512_db: [f32; 512], applied_preamp_db: f32, active_device: DeviceInfo }&lt;/span&gt;" vertex="1">
            <mxGeometry height="70" width="715" x="755" y="36" as="geometry" />
          </mxCell>
          <mxCell id="p1_l2_container" parent="1" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2.5;fontColor=#1E3A8A;verticalAlign=top;align=left;spacingLeft=18;spacingTop=10;arcSize=4;" value="&lt;b style=&quot;font-size:15px;&quot;&gt;LAYER 2 — AI Model &amp;amp; Intent Resolution Layer (On-Device TFLite Isolate)&lt;/b&gt; &amp;nbsp;&lt;span style=&quot;font-size:12px;color:#1E40AF;&quot;&gt;| 100% OS-Agnostic Background Inference &amp;amp; OSI Pass-Through Mux&lt;/span&gt;" vertex="1">
            <mxGeometry height="195" width="1490" x="30" y="990" as="geometry" />
          </mxCell>
          <mxCell id="p1_l2_autoeq" parent="p1_l2_container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E40AF;strokeColor=#1E3A8A;fontColor=#FFFFFF;arcSize=8;spacing=10;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Base 7-Band AutoEQ Predictor&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#BFDBFE;&quot;&gt;[INT8 .tflite: 1D CNN + MLP]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;1024-pt input &lt;b&gt;[Headphone FR + Target FR] -&amp;gt; 7x3 = 21 params&lt;/b&gt; (freq, gain, Q) for baseline correction.&lt;/span&gt;" vertex="1">
            <mxGeometry height="130" width="440" x="20" y="48" as="geometry" />
          </mxCell>
          <mxCell id="p1_l2_semantic" parent="p1_l2_container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E40AF;strokeColor=#1E3A8A;fontColor=#FFFFFF;arcSize=8;spacing=10;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Abstract Semantic Tuning Predictor&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#BFDBFE;&quot;&gt;[INT8 .tflite: Semantic Delta Network]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Maps &lt;b&gt;&amp;quot;More Bass&amp;quot;, &amp;quot;Richer Sound&amp;quot;, &amp;quot;Warmth&amp;quot;, &amp;quot;Clarity&amp;quot;&lt;/b&gt; vector &lt;b&gt;[f32; 4]&lt;/b&gt; + base bands -&amp;gt; &lt;b&gt;Delta[freq, gain, Q]_7&lt;/b&gt;.&lt;/span&gt;" vertex="1">
            <mxGeometry height="130" width="460" x="480" y="48" as="geometry" />
          </mxCell>
          <mxCell id="p1_l2_mux" parent="p1_l2_container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#312E81;strokeColor=#1E1B4B;strokeWidth=2;fontColor=#FFFFFF;arcSize=8;spacing=10;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;OSI Caveat: Manual Pass-Through &amp;amp; Telemetry Relay Mux&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C7D2FE;&quot;&gt;[Strict L1 &amp;lt;-&amp;gt; L2 &amp;lt;-&amp;gt; L3 Adjacency Gate]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;On &lt;b&gt;IntentMode::ManualOverride&lt;/b&gt;, bypasses TFLite (0 ms) and forwards 7-band frame unchanged across SAP-2 to L3. Relays L3 512-pt FR &amp;amp; device events down to L1.&lt;/span&gt;" vertex="1">
            <mxGeometry height="130" width="510" x="960" y="48" as="geometry" />
          </mxCell>
          <mxCell id="p1_sap1_container" parent="1" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#E0F2FE;strokeColor=#0369A1;strokeWidth=2.5;fontColor=#0C4A6E;verticalAlign=top;align=left;spacingLeft=18;spacingTop=8;arcSize=6;" value="&lt;b style=&quot;font-size:14px;&quot;&gt;SAP-1: UI-to-AI Intent &amp;amp; Telemetry Interface (Dart Isolate SendPort / ReceivePort Contract)&lt;/b&gt;" vertex="1">
            <mxGeometry height="120" width="1490" x="30" y="1235" as="geometry" />
          </mxCell>
          <mxCell id="p1_sap1_up" parent="p1_sap1_container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1.5;fontColor=#0F172A;arcSize=6;spacing=6;align=left;spacingLeft=12;" value="&lt;b style=&quot;font-size:11px;color:#0369A1;&quot;&gt;Upward Intent PDU (L1 -&amp;gt; L2):&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;font-size:10.5px;&quot;&gt;UserTuningIntent { mode: AutoEq | SemanticDelta([f32; 4]) | ManualOverride([BiquadBandSpec; 7]), measured_fr_512: [f32; 512], target_fr_512: [f32; 512], bypass: bool }&lt;/span&gt;" vertex="1">
            <mxGeometry height="70" width="715" x="20" y="36" as="geometry" />
          </mxCell>
          <mxCell id="p1_sap1_down" parent="p1_sap1_container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.5;fontColor=#0F172A;arcSize=6;spacing=6;align=left;spacingLeft=12;" value="&lt;b style=&quot;font-size:11px;color:#6D28D9;&quot;&gt;Downward UI View-State SDU (L2 -&amp;gt; L1):&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;font-size:10.5px;&quot;&gt;UiRenderState { bands_7: [BiquadBandSpec; 7], eq_curve_512_db: [f32; 512], compensated_fr_512_db: [f32; 512], preamp_db: f32, connected_headset: Option&amp;lt;String&amp;gt; }&lt;/span&gt;" vertex="1">
            <mxGeometry height="70" width="715" x="755" y="36" as="geometry" />
          </mxCell>
          <mxCell id="p1_l1_container" parent="1" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#EFF6FF;strokeColor=#1D4ED8;strokeWidth=2.5;fontColor=#1E3A8A;verticalAlign=top;align=left;spacingLeft=18;spacingTop=10;arcSize=4;" value="&lt;b style=&quot;font-size:15px;&quot;&gt;LAYER 1 (BOTTOM) — Flutter Presentation &amp;amp; Persistence Shell Layer&lt;/b&gt; &amp;nbsp;&lt;span style=&quot;font-size:12px;color:#1D4ED8;&quot;&gt;| 100% OS-Agnostic Thin UI &amp;amp; Local Storage (Zero DSP math or OS audio calls)&lt;/span&gt;" vertex="1">
            <mxGeometry height="170" width="1490" x="30" y="1405" as="geometry" />
          </mxCell>
          <mxCell id="p1_l1_ui" parent="p1_l1_container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#1D4ED8;fontColor=#FFFFFF;arcSize=8;spacing=10;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Flutter Thin UI Shell (Material 3, Riverpod)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;7-band interactive frequency response chart (&lt;b&gt;CustomPainter&lt;/b&gt;), semantic sliders (&lt;i&gt;&amp;quot;More Bass&amp;quot;, &amp;quot;Richer Sound&amp;quot;, &amp;quot;Warmth&amp;quot;, &amp;quot;Clarity&amp;quot;&lt;/i&gt;), headphone search, and A/B bypass switch.&lt;/span&gt;" vertex="1">
            <mxGeometry height="108" width="715" x="20" y="46" as="geometry" />
          </mxCell>
          <mxCell id="p1_l1_sqlite" parent="p1_l1_container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0284C7;strokeColor=#0369A1;fontColor=#FFFFFF;arcSize=8;spacing=10;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Local SQLite Persistence (sqlite3 / drift)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Bundled read-only &lt;b&gt;AutoEQ SQLite DB&lt;/b&gt; (&lt;b&gt;FTS5&lt;/b&gt; search + binary &lt;b&gt;FLOAT32 BLOB&lt;/b&gt; 512-pt curves) and read-write &lt;b&gt;User Profiles SQLite DB&lt;/b&gt; (saved 7-band presets &amp;amp; headset mappings).&lt;/span&gt;" vertex="1">
            <mxGeometry height="108" width="715" x="755" y="46" as="geometry" />
          </mxCell>
          <mxCell id="p1_portability_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2.5;fontColor=#064E3B;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=16;arcSize=6;" value="&lt;b style=&quot;font-size:15px;color:#065F46;&quot;&gt;ZERO-CHANGE PORTABILITY GUARANTEE (Layer 4 Swap)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;&quot;&gt;Swapping the Layer 4 OS module (e.g., Android &lt;b&gt;DynamicsProcessing&lt;/b&gt; &amp;rarr; iOS &lt;b&gt;AUv3&lt;/b&gt;, Windows &lt;b&gt;APO / WASAPI&lt;/b&gt;, or Linux &lt;b&gt;PipeWire&lt;/b&gt;) requires:&lt;/span&gt;&lt;br&gt;&lt;br&gt;&amp;bull; &lt;b&gt;ZERO changes&lt;/b&gt; to Layer 1 (Flutter UI &amp;amp; SQLite)&lt;br&gt;&amp;bull; &lt;b&gt;ZERO changes&lt;/b&gt; to Layer 2 (TFLite AI &amp;amp; Intent Mux)&lt;br&gt;&amp;bull; &lt;b&gt;ZERO changes&lt;/b&gt; to Layer 3 (Rust &lt;b&gt;libeqai_math&lt;/b&gt; DSP Core)&lt;br&gt;&amp;bull; &lt;b&gt;ZERO changes&lt;/b&gt; to SAP-1, SAP-2, or SAP-3 interface contracts" vertex="1">
            <mxGeometry height="235" width="620" x="1550" y="110" as="geometry" />
          </mxCell>
          <mxCell id="p1_osi_caveats_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=16;arcSize=6;" value="&lt;b style=&quot;font-size:15px;color:#0F172A;&quot;&gt;OSI Reference Analogy &amp;amp; Architectural Caveats&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size:12.5px;color:#0F766E;&quot;&gt;1. Strict Adjacent-Layer Encapsulation (L1 &amp;lt;-&amp;gt; L2 &amp;lt;-&amp;gt; L3 &amp;lt;-&amp;gt; L4)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#334155;&quot;&gt;Each layer communicates ONLY with its immediately adjacent layer(s) through formal Service Access Points (SAP-1, SAP-2, SAP-3). Upward calls encapsulate intents/commands into PDUs; downward callbacks deliver telemetry &amp;amp; hardware events as SDUs. No layer-skipping calls exist.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size:12.5px;color:#1D4ED8;&quot;&gt;2. Caveat 1 — Manual Tuning Mux in Layer 2&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#334155;&quot;&gt;Manual 7-band slider adjustments (&lt;i&gt;IntentMode::ManualOverride&lt;/i&gt;) flow &lt;b&gt;L1 &amp;rarr; L2 (Identity Pass-Through Mux, 0 ms TFLite overhead) &amp;rarr; L3&lt;/b&gt;. Keeping L2 as the single ingress gate ensures L1 never couples directly to L3&amp;apos;s FFI or audio internals.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size:12.5px;color:#B45309;&quot;&gt;3. Caveat 2 — Top-Layer OS Portability&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#334155;&quot;&gt;Only Layer 4 contains OS-specific drivers (Android &lt;i&gt;jni-rs&lt;/i&gt;, iOS &lt;i&gt;CoreAudio&lt;/i&gt;, Windows &lt;i&gt;COM/WASAPI&lt;/i&gt;, Linux &lt;i&gt;PipeWire/ALSA&lt;/i&gt;). Layers 1, 2, and 3 contain zero OS-specific types, imports, or handles.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size:12.5px;color:#6D28D9;&quot;&gt;4. Dual-Mode L4 Execution via SAP-3&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#334155;&quot;&gt;&amp;bull; &lt;b&gt;Parameter-Push OS (Android MVP):&lt;/b&gt; L3 pushes 7-band specs/coeffs via &lt;i&gt;apply_biquad_cascade()&lt;/i&gt;.&lt;br&gt;&amp;bull; &lt;b&gt;Buffer-Pull OS (iOS / Windows / Linux):&lt;/b&gt; L4 audio callback pulls filtered audio from L3&amp;apos;s DF-II-T engine via &lt;i&gt;process_pcm_frames()&lt;/i&gt;.&lt;/span&gt;" vertex="1">
            <mxGeometry height="650" width="620" x="1550" y="395" as="geometry" />
          </mxCell>
          <mxCell id="p1_legend_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=16;arcSize=6;" value="&lt;b style=&quot;font-size:15px;&quot;&gt;Legend — OSI Stack Notation &amp;amp; Signal Flows&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#065F46&quot; style=&quot;font-size:15px;&quot;&gt;&amp;#9632;&lt;/font&gt; &amp;nbsp;&lt;b&gt;Layer 4 Active MVP&lt;/b&gt; (Android DynamicsProcessing via jni-rs)&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:15px;&quot;&gt;&amp;#9633;&lt;/font&gt; &amp;nbsp;&lt;b&gt;Layer 4 Plug-Compatible Backends&lt;/b&gt; (Dashed: iOS, Windows, Linux)&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#B45309&quot; style=&quot;font-size:15px;&quot;&gt;&amp;#9632;&lt;/font&gt; &amp;nbsp;&lt;b&gt;Layer 3&lt;/b&gt; — Pure Rust DSP Engine (libeqai_math, OS-agnostic)&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#1E40AF&quot; style=&quot;font-size:15px;&quot;&gt;&amp;#9632;&lt;/font&gt; &amp;nbsp;&lt;b&gt;Layer 2&lt;/b&gt; — On-Device TFLite AI Isolate &amp;amp; Pass-Through Mux&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2563EB&quot; style=&quot;font-size:15px;&quot;&gt;&amp;#9632;&lt;/font&gt; &amp;nbsp;&lt;b&gt;Layer 1&lt;/b&gt; — Flutter Thin UI Shell &amp;amp; Local SQLite Persistence&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#0F766E&quot; style=&quot;font-size:15px;&quot;&gt;&amp;#9644;&lt;/font&gt; &amp;nbsp;&lt;b&gt;Service Access Point (SAP-1 / SAP-2 / SAP-3)&lt;/b&gt; — Formal Layer Contract&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#0369A1&quot; style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;&amp;#8593;&lt;/b&gt;&lt;/font&gt; &amp;nbsp;&lt;b&gt;Upward Flow (Solid)&lt;/b&gt; — Intent / Command / Control PDUs (L1 &amp;rarr; L4)&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6D28D9&quot; style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;&amp;#8595;&lt;/b&gt;&lt;/font&gt; &amp;nbsp;&lt;b&gt;Downward Flow (Dashed)&lt;/b&gt; — Telemetry &amp;amp; Hardware Event SDUs (L4 &amp;rarr; L1)&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot; style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;&amp;#8597;&lt;/b&gt;&lt;/font&gt; &amp;nbsp;&lt;b&gt;Bidirectional Real-Time PCM&lt;/b&gt; — process_pcm_frames (L4 &amp;lt;-&amp;gt; L3)" vertex="1">
            <mxGeometry height="500" width="620" x="1550" y="1075" as="geometry" />
          </mxCell>
          <mxCell id="p1_edge_l1_sap1_up" edge="1" parent="1" source="p1_l1_container" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0369A1;strokeWidth=2.5;endArrow=classic;endFill=1;fontColor=#0C4A6E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.22;exitY=0;exitDx=0;exitDy=0;entryX=0.22;entryY=1;entryDx=0;entryDy=0;" target="p1_sap1_container" value="Upward Intent PDU (UserTuningIntent)">
            <mxGeometry relative="1" as="geometry" />
