      </mxGraphModel>
    </diagram>
  <diagram id="osi-lower-if" name="2. SAP-1 &amp; SAP-2 Interfaces (L1-L2-L3)">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1650" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
          <mxCell id="p2_title" value="&lt;b style=&quot;font-size:19px;&quot;&gt;EQAI — OSI Architecture Page 2: SAP-1 &amp;amp; SAP-2 Lower-Layer Interface Contracts (L1 ↔ L2 ↔ L3)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#CBD5E1;&quot;&gt;Platform-Independent Service Access Points Between Layer 1 (Bottom: Flutter Thin UI Shell), Layer 2 (AI Model Isolate &amp;amp; OSI Caveat Multiplexer), and Layer 3 (Top of Page: Rust Mathematical Engine)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#020617;strokeWidth=2;fontColor=#FFFFFF;align=left;spacingLeft=20;verticalAlign=middle;" vertex="1" parent="1">
            <mxGeometry x="40" y="20" width="2320" height="65" as="geometry" />
          </mxCell>
          <mxCell id="p2_boundary_l3" value="&lt;b&gt;Layer 3 (Upper-Middle Layer): Rust Mathematical &amp;amp; DSP Engine (libeqai_math) — OS-Agnostic Pure Rust Core&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#FEF9F3;strokeColor=#B9770E;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontColor=#7E5109;" vertex="1" parent="1">
            <mxGeometry x="40" y="105" width="1860" height="190" as="geometry" />
          </mxCell>
          <mxCell id="p2_l3_bridge" value="&lt;b&gt;sap2_bridge.rs (C-ABI / FFI Entrypoint &amp;amp; Route Registry)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#7E5109;&quot;&gt;[L3 Component: #[no_mangle] extern &amp;quot;C&amp;quot; / flutter_rust_bridge]&lt;/font&gt;&lt;br&gt;• Exports &lt;b&gt;sap2_commit_eq_frame&lt;/b&gt;, &lt;b&gt;sap2_set_global_bypass&lt;/b&gt;, &lt;b&gt;sap2_register_route_listener&lt;/b&gt;&lt;br&gt;• Validates 7-band bounds (freq ∈ [20, 20k] Hz, gain ∈ [-15, +15] dB, Q ∈ [0.3, 12.0])&lt;br&gt;• Relays L4→L3 hardware device events down via registered C callback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5CBA7;strokeColor=#B9770E;strokeWidth=1.5;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;" vertex="1" parent="1">
            <mxGeometry x="60" y="138" width="580" height="145" as="geometry" />
          </mxCell>
          <mxCell id="p2_l3_solver" value="&lt;b&gt;biquad_solver.rs (7-Band RBJ Biquad &amp;amp; Preamp Engine)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#7E5109;&quot;&gt;[L3 Component: Pure Rust f64 DSP Math]&lt;/font&gt;&lt;br&gt;• Computes 7 × &lt;b&gt;BiquadCoeffs&lt;/b&gt; (b0, b1, b2, a1, a2) for LowShelf / PeakBell / HighShelf&lt;br&gt;• Evaluates 512-pt log-grid (20 Hz–20 kHz) &lt;b&gt;composite_eq_db[512]&lt;/b&gt; &amp;amp; &lt;b&gt;compensated_fr_db[512]&lt;/b&gt;&lt;br&gt;• Computes anti-clipping headroom &lt;b&gt;computed_preamp_db&lt;/b&gt; and returns &lt;b&gt;EqMathTelemetryFrame&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5CBA7;strokeColor=#B9770E;strokeWidth=1.5;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;" vertex="1" parent="1">
            <mxGeometry x="660" y="138" width="600" height="145" as="geometry" />
          </mxCell>
          <mxCell id="p2_l3_hal_dispatch" value="&lt;b&gt;hal_dispatcher.rs (SAP-3 Upward Dispatch &amp;amp; Crossfade Smoother)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#7E5109;&quot;&gt;[L3 → SAP-3 Bridge: trait UniversalSystemAudioHal]&lt;/font&gt;&lt;br&gt;• Applies &lt;b&gt;crossfade_duration_ms&lt;/b&gt; parameter interpolation to avoid zipper noise&lt;br&gt;• Calls SAP-3 upward contract to push 7-band coeffs &amp;amp; preamp to Layer 4 (Android / iOS / Win / Linux)&lt;br&gt;• &lt;i&gt;Strict OSI Isolation: zero knowledge of Flutter, Dart Isolates, or TFLite&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5CBA7;strokeColor=#B9770E;strokeWidth=1.5;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;" vertex="1" parent="1">
            <mxGeometry x="1280" y="138" width="600" height="145" as="geometry" />
          </mxCell>
          <mxCell id="p2_boundary_sap2" value="&lt;b&gt;SAP-2 Interface Contract (Layer 2 ↔ Layer 3): Universal C-ABI / flutter_rust_bridge FFI (#[repr(C)] Structs, Zero OS-Specific Types)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 3;fillColor=#F5F3FF;strokeColor=#6D28D9;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontColor=#4C1D95;" vertex="1" parent="1">
            <mxGeometry x="40" y="350" width="1860" height="315" as="geometry" />
          </mxCell>
          <mxCell id="p2_sap2_primitives" value="&lt;b&gt;SAP-2 Transport &amp;amp; Upward Service Primitives (L2 → L3 FFI Calls)&lt;/b&gt;&lt;br&gt;&lt;b&gt;Transport:&lt;/b&gt; Universal C-ABI / &lt;code&gt;flutter_rust_bridge&lt;/code&gt; FFI (&lt;code&gt;#[repr(C)]&lt;/code&gt;, zero OS types)&lt;br&gt;&lt;br&gt;&lt;b&gt;1.&lt;/b&gt; &lt;code&gt;sap2_commit_eq_frame(frame: *const EqParameterFrame, measured_fr_512: *const f32, out_telemetry: *mut EqMathTelemetryFrame) -&amp;gt; i32&lt;/code&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; &lt;code&gt;sap2_set_global_bypass(bypass: bool) -&amp;gt; i32&lt;/code&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; &lt;code&gt;sap2_register_route_listener(cb: extern &amp;quot;C&amp;quot; fn(*const RawDeviceEvent)) -&amp;gt; i32&lt;/code&gt;&lt;br&gt;&lt;i&gt;(Downward L3 → L2 callback invoked asynchronously when L4 reports wired/BT/speaker route change)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#6D28D9;strokeWidth=1.5;fontColor=#1E1B4B;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=10.5;" vertex="1" parent="1">
            <mxGeometry x="60" y="384" width="600" height="268" as="geometry" />
          </mxCell>
          <mxCell id="p2_sap2_structs_in" value="&lt;b&gt;SAP-2 Canonical Input Structures (#[repr(C)])&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;BiquadFilterType (u8):&lt;/b&gt;&lt;br&gt;&lt;code&gt;0 = LowShelf | 1 = PeakBell | 2 = HighShelf&lt;/code&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;BiquadBandSpec (32 bytes, #[repr(C)]):&lt;/b&gt;&lt;br&gt;&lt;code&gt;{ band_idx: u8, filter_type: u8, enabled: u8, _pad: u8, freq_hz: f64, gain_db: f64, q_factor: f64 }&lt;/code&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;EqParameterFrame (240 bytes, #[repr(C)]):&lt;/b&gt;&lt;br&gt;&lt;code&gt;{ bands: [BiquadBandSpec; 7], preamp_override_db: f32, has_preamp_override: u8, bypass: u8, crossfade_duration_ms: u16, target_sample_rate_hz: u32 }&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#6D28D9;strokeWidth=1.5;fontColor=#1E1B4B;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=10.5;" vertex="1" parent="1">
            <mxGeometry x="680" y="384" width="580" height="268" as="geometry" />
          </mxCell>
          <mxCell id="p2_sap2_structs_out" value="&lt;b&gt;SAP-2 Canonical Telemetry &amp;amp; Route Structures (#[repr(C)])&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;BiquadCoeffs (40 bytes, #[repr(C)]):&lt;/b&gt;&lt;br&gt;&lt;code&gt;{ b0: f64, b1: f64, b2: f64, a1: f64, a2: f64 }&lt;/code&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;EqMathTelemetryFrame (#[repr(C)]):&lt;/b&gt;&lt;br&gt;&lt;code&gt;{ coeffs: [BiquadCoeffs; 7], composite_eq_db: [f32; 512], compensated_fr_db: [f32; 512], computed_preamp_db: f32, peak_gain_db: f32, status_code: i32 }&lt;/code&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;RawDeviceEvent (#[repr(C)]):&lt;/b&gt;&lt;br&gt;&lt;code&gt;{ device_name_utf8: [u8; 128], transport: u8, sample_rate_hz: u32 }&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#6D28D9;strokeWidth=1.5;fontColor=#1E1B4B;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=10.5;" vertex="1" parent="1">
            <mxGeometry x="1280" y="384" width="600" height="268" as="geometry" />
          </mxCell>
          <mxCell id="p2_boundary_l2" value="&lt;b&gt;Layer 2 (Middle-Lower Layer): AI Model Isolate (tflite_flutter) — Internal Interface Adapter &amp;amp; OSI Caveat Multiplexer&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#F3FBF6;strokeColor=#239B56;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontColor=#14532D;" vertex="1" parent="1">
            <mxGeometry x="40" y="725" width="1860" height="235" as="geometry" />
          </mxCell>
          <mxCell id="p2_l2_path_a" value="&lt;b&gt;Path A: AutoEq Neural Inference&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;[L2 Adapter: SAP1_RequestAutoEq → SAP-2]&lt;/font&gt;&lt;br&gt;• Concatenates &lt;code&gt;headphone_fr_512&lt;/code&gt; + &lt;code&gt;target_fr_512&lt;/code&gt; → &lt;b&gt;[1024]&lt;/b&gt; f32 tensor&lt;br&gt;• Runs &lt;b&gt;base_eq_int8.tflite&lt;/b&gt; (&lt;code&gt;[1024] → [7×3 = 21]&lt;/code&gt;)&lt;br&gt;• Maps 21 outputs to 7× &lt;code&gt;BiquadBandSpec&lt;/code&gt; (&lt;code&gt;has_preamp_override = 0&lt;/code&gt;)&lt;br&gt;• Emits &lt;b&gt;EqParameterFrame&lt;/b&gt; to SAP-2 &lt;code&gt;sap2_commit_eq_frame()&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A9DFBF;strokeColor=#239B56;strokeWidth=1.5;fontColor=#064E3B;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=10.5;" vertex="1" parent="1">
            <mxGeometry x="60" y="758" width="450" height="188" as="geometry" />
          </mxCell>
          <mxCell id="p2_l2_path_b" value="&lt;b&gt;Path B: SemanticDelta Tuning&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;[L2 Adapter: SAP1_RequestSemanticTuning → SAP-2]&lt;/font&gt;&lt;br&gt;• Packs &lt;code&gt;base_bands_7&lt;/code&gt; (21) + &lt;code&gt;semantic_vec_4&lt;/code&gt; (4) + &lt;code&gt;headphone_fr_512&lt;/code&gt; (512)&lt;br&gt;• Runs &lt;b&gt;abstract_tuning_int8.tflite&lt;/b&gt; (&lt;code&gt;[21+4+512] → Δ[7×3 = 21]&lt;/code&gt;)&lt;br&gt;• Adds Δ to base bands; clamps &lt;code&gt;freq_hz&lt;/code&gt;, &lt;code&gt;gain_db&lt;/code&gt;, &amp;amp; &lt;code&gt;q_factor&lt;/code&gt; bounds&lt;br&gt;• Emits clamped 7-band &lt;b&gt;EqParameterFrame&lt;/b&gt; to SAP-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A9DFBF;strokeColor=#239B56;strokeWidth=1.5;fontColor=#064E3B;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=10.5;" vertex="1" parent="1">
            <mxGeometry x="530" y="758" width="460" height="188" as="geometry" />
          </mxCell>
          <mxCell id="p2_l2_path_c" value="&lt;b&gt;Path C: ManualOverride (OSI Caveat Pass-Through)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;[L2 Deterministic Gate: 0 ms ML Overhead]&lt;/font&gt;&lt;br&gt;• Handles &lt;code&gt;SAP1_ForwardManualOverride&lt;/code&gt; &amp;amp; &lt;code&gt;SAP1_SetSystemBypass&lt;/code&gt;&lt;br&gt;• &lt;b&gt;Skips .tflite interpreters completely&lt;/b&gt; (0 ms AI latency)&lt;br&gt;• Wraps &lt;code&gt;manual_bands_7&lt;/code&gt; + &lt;code&gt;manual_preamp_db&lt;/code&gt; into &lt;b&gt;EqParameterFrame&lt;/b&gt;&lt;br&gt;• &lt;i&gt;Preserves strict OSI boundary: L1 stays 100% decoupled from L3&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#047857;strokeWidth=2;dashed=1;dashPattern=4 2;fontColor=#064E3B;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=10.5;" vertex="1" parent="1">
            <mxGeometry x="1010" y="758" width="450" height="188" as="geometry" />
          </mxCell>
          <mxCell id="p2_l2_down_adapter" value="&lt;b&gt;Telemetry &amp;amp; Route Downward Adapter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;[L2 Adapter: SAP-2 → SAP-1 Receive/SendPort]&lt;/font&gt;&lt;br&gt;• Wraps &lt;code&gt;EqMathTelemetryFrame&lt;/code&gt; + measured &lt;code&gt;inference_latency_us&lt;/code&gt; into &lt;b&gt;SAP1_OnTelemetryUpdated&lt;/b&gt;&lt;br&gt;• Marshals &lt;code&gt;RawDeviceEvent&lt;/code&gt; callback from SAP-2 into &lt;b&gt;SAP1_OnHardwareRouteEvent&lt;/b&gt;&lt;br&gt;• Transfers 512-pt buffers zero-copy via &lt;code&gt;TransferableTypedData&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A9DFBF;strokeColor=#239B56;strokeWidth=1.5;fontColor=#064E3B;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=10.5;" vertex="1" parent="1">
            <mxGeometry x="1480" y="758" width="400" height="188" as="geometry" />
          </mxCell>
          <mxCell id="p2_boundary_sap1" value="&lt;b&gt;SAP-1 Interface Contract (Layer 1 ↔ Layer 2): Asynchronous Zero-Copy Dart Isolate Message Channel (TransferableTypedData / SendPort &amp;amp; ReceivePort)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 3;fillColor=#ECFEFF;strokeColor=#0E7490;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontColor=#155E75;" vertex="1" parent="1">
            <mxGeometry x="40" y="1020" width="1860" height="295" as="geometry" />
          </mxCell>
          <mxCell id="p2_sap1_transport" value="&lt;b&gt;SAP-1 Transport &amp;amp; Contract Guarantees&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Channel:&lt;/b&gt; Async Zero-Copy Dart Isolate Message Channel (&lt;code&gt;TransferableTypedData&lt;/code&gt; / &lt;code&gt;SendPort&lt;/code&gt; &amp;amp; &lt;code&gt;ReceivePort&lt;/code&gt;)&lt;br&gt;&lt;br&gt;• &lt;b&gt;UI Thread Safety:&lt;/b&gt; L1 never blocks on TFLite inference or FFI math&lt;br&gt;&lt;br&gt;• &lt;b&gt;OS Independence:&lt;/b&gt; Pure Dart &amp;amp; TypedData primitives; zero MethodChannel or OS handles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFFAFE;strokeColor=#0E7490;strokeWidth=1.5;fontColor=#083344;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=10.5;" vertex="1" parent="1">
            <mxGeometry x="60" y="1054" width="360" height="248" as="geometry" />
          </mxCell>
          <mxCell id="p2_sap1_upward" value="&lt;b&gt;SAP-1 Upward Service Primitives (L1 → L2 Requests)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1.&lt;/b&gt; &lt;code&gt;SAP1_RequestAutoEq(headphone_fr_512: Float32List[512], target_fr_512: Float32List[512])&lt;/code&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; &lt;code&gt;SAP1_RequestSemanticTuning(base_bands_7: BiquadBandSpec[7], semantic_vec_4: Float32List[4] /* [bass, richness, warmth, clarity] in -1.0..1.0 */, headphone_fr_512: Float32List[512])&lt;/code&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; &lt;code&gt;SAP1_ForwardManualOverride(manual_bands_7: BiquadBandSpec[7], manual_preamp_db: Option&amp;lt;f32&amp;gt;, bypass: bool)&lt;/code&gt; &lt;i&gt;(OSI Caveat: routed through L2 deterministic pass-through gate)&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; &lt;code&gt;SAP1_SetSystemBypass(bypass: bool)&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFFAFE;strokeColor=#0E7490;strokeWidth=1.5;fontColor=#083344;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=10.5;" vertex="1" parent="1">
            <mxGeometry x="440" y="1054" width="760" height="248" as="geometry" />
          </mxCell>
          <mxCell id="p2_sap1_downward" value="&lt;b&gt;SAP-1 Downward Service Primitives (L2 → L1 Indications / Confirmations)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1.&lt;/b&gt; &lt;code&gt;SAP1_OnTelemetryUpdated(effective_bands_7: BiquadBandSpec[7], composite_eq_512_db: Float32List[512], compensated_fr_512_db: Float32List[512], safe_preamp_db: f32, inference_latency_us: u32)&lt;/code&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; &lt;code&gt;SAP1_OnHardwareRouteEvent(device_name: String, transport_type: Wired | Bluetooth | Speaker, sample_rate_hz: u32)&lt;/code&gt;&lt;br&gt;&lt;i&gt;(Relayed down from L4 → L3 → L2 → L1 so Layer 1 can look up the matching headphone profile in SQLite without direct OS coupling)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFFAFE;strokeColor=#0E7490;strokeWidth=1.5;fontColor=#083344;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=10.5;" vertex="1" parent="1">
            <mxGeometry x="1220" y="1054" width="660" height="248" as="geometry" />
          </mxCell>
          <mxCell id="p2_boundary_l1" value="&lt;b&gt;Layer 1 (Bottom-Most Layer): Flutter Thin UI Shell &amp;amp; Local Persistence (Material 3 / Riverpod / CustomPainter / SQLite)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#F4F8FD;strokeColor=#2E6295;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontColor=#0B3B6E;" vertex="1" parent="1">
            <mxGeometry x="40" y="1375" width="1860" height="245" as="geometry" />
          </mxCell>
          <mxCell id="p2_l1_sqlite" value="&lt;b&gt;ProfileRepository (SQLite FTS5 + drift)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;[L1 Local Data Store]&lt;/font&gt;&lt;br&gt;• Stores ~4,000 AutoEQ FR curves (&lt;code&gt;FLOAT32&lt;/code&gt; BLOBs) &amp;amp; saved profiles&lt;br&gt;• On &lt;code&gt;SAP1_OnHardwareRouteEvent&lt;/code&gt;, looks up matching profile for &lt;code&gt;device_name&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#2E6295;strokeWidth=1.5;fontColor=#082F49;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=10.5;" vertex="1" parent="1">
            <mxGeometry x="60" y="1410" width="410" height="155" as="geometry" />
          </mxCell>
          <mxCell id="p2_l1_sliders" value="&lt;b&gt;Manual &amp;amp; Semantic UI (Material 3)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;[L1 Presentation Widgets]&lt;/font&gt;&lt;br&gt;• 7-band manual parametric controls + preamp + A/B bypass toggle&lt;br&gt;• 4 abstract semantic sliders: &lt;code&gt;[bass, richness, warmth, clarity]&lt;/code&gt; in &lt;code&gt;-1.0..1.0&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#2E6295;strokeWidth=1.5;fontColor=#082F49;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=10.5;" vertex="1" parent="1">
            <mxGeometry x="490" y="1410" width="410" height="155" as="geometry" />
          </mxCell>
          <mxCell id="p2_l1_riverpod" value="&lt;b&gt;EqStateNotifier (Riverpod + SAP-1 Client)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;[L1 Thin Shell Facade: SendPort / ReceivePort]&lt;/font&gt;&lt;br&gt;• Emits all 4 upward &lt;b&gt;SAP-1&lt;/b&gt; requests to L2 Isolate&lt;br&gt;• Receives &lt;b&gt;SAP1_OnTelemetryUpdated&lt;/b&gt; &amp;amp; &lt;b&gt;SAP1_OnHardwareRouteEvent&lt;/b&gt;&lt;br&gt;• &lt;i&gt;Zero direct FFI calls to Rust (L3) and zero OS audio API imports&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#2E6295;strokeWidth=1.5;fontColor=#082F49;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=10.5;" vertex="1" parent="1">
            <mxGeometry x="920" y="1410" width="460" height="195" as="geometry" />
          </mxCell>
          <mxCell id="p2_l1_painter" value="&lt;b&gt;FR &amp;amp; EQ Curve Visualizer (CustomPainter)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;[L1 Native Canvas API — 60 fps]&lt;/font&gt;&lt;br&gt;• Renders &lt;code&gt;composite_eq_512_db&lt;/code&gt; &amp;amp; &lt;code&gt;compensated_fr_512_db&lt;/code&gt; (20 Hz–20 kHz)&lt;br&gt;• Displays &lt;code&gt;safe_preamp_db&lt;/code&gt;, 7 draggable EQ nodes, &amp;amp; &lt;code&gt;inference_latency_us&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#2E6295;strokeWidth=1.5;fontColor=#082F49;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=10.5;" vertex="1" parent="1">
            <mxGeometry x="1400" y="1410" width="480" height="195" as="geometry" />
          </mxCell>
          <mxCell id="p2_invariant_box" value="&lt;b style=&quot;font-size:14px;color:#991B1B;&quot;&gt;Architectural Invariant: 100% OS-Immune Contracts&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Why SAP-1 and SAP-2 Never Change Across Operating Systems:&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Zero OS Types, Imports, or Handles:&lt;/b&gt;&lt;br&gt;Neither SAP-1 nor SAP-2 references Android (&lt;code&gt;JNI&lt;/code&gt;, &lt;code&gt;DynamicsProcessing&lt;/code&gt;, &lt;code&gt;AudioManager&lt;/code&gt;), iOS (&lt;code&gt;AUv3&lt;/code&gt;, &lt;code&gt;AVAudioEngine&lt;/code&gt;), Windows (&lt;code&gt;WASAPI&lt;/code&gt;, &lt;code&gt;APO&lt;/code&gt;, &lt;code&gt;COM&lt;/code&gt;), or Linux (&lt;code&gt;PipeWire&lt;/code&gt;, &lt;code&gt;ALSA&lt;/code&gt;) symbols.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Pure Mathematical &amp;amp; Memory Primitives:&lt;/b&gt;&lt;br&gt;• &lt;b&gt;SAP-1&lt;/b&gt; transfers Dart &lt;code&gt;TransferableTypedData&lt;/code&gt; / &lt;code&gt;Float32List[512]&lt;/code&gt; &amp;amp; &lt;code&gt;BiquadBandSpec[7]&lt;/code&gt;.&lt;br&gt;• &lt;b&gt;SAP-2&lt;/b&gt; transfers fixed-layout &lt;code&gt;#[repr(C)]&lt;/code&gt; C-ABI structs (&lt;code&gt;EqParameterFrame&lt;/code&gt;, &lt;code&gt;EqMathTelemetryFrame&lt;/code&gt;) and pure UTF-8 &lt;code&gt;RawDeviceEvent&lt;/code&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Plug-Compatible Top Layer (L4):&lt;/b&gt;&lt;br&gt;Swapping the Layer 4 OS Audio Backend behind &lt;b&gt;SAP-3&lt;/b&gt; requires &lt;b&gt;0 lines changed&lt;/b&gt; in Layer 1, SAP-1, Layer 2, or SAP-2.&lt;br&gt;&lt;br&gt;&lt;b&gt;4. Strict OSI Adjacency (L2 Caveat Gate):&lt;/b&gt;&lt;br&gt;Manual 7-band overrides enter L2 via &lt;code&gt;SAP1_ForwardManualOverride&lt;/code&gt; and take the &lt;b&gt;0 ms Path C pass-through&lt;/b&gt; to SAP-2, keeping L1 strictly decoupled from L3." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=2;fontColor=#450A0A;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=12;fontSize=11;" vertex="1" parent="1">
            <mxGeometry x="1925" y="105" width="435" height="560" as="geometry" />
          </mxCell>
          <mxCell id="p2_legend" value="&lt;b style=&quot;font-size:14px;&quot;&gt;Legend — OSI Lower-Layer Interface Key&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#B9770E&quot; style=&quot;font-size:15px;&quot;&gt;&amp;#9632;&lt;/font&gt; &lt;b&gt;Layer 3 (Upper-Middle):&lt;/b&gt; Rust Math Engine (&lt;code&gt;libeqai_math&lt;/code&gt;)&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6D28D9&quot; style=&quot;font-size:15px;&quot;&gt;&amp;#9632;&lt;/font&gt; &lt;b&gt;SAP-2 Band (L2 ↔ L3):&lt;/b&gt; Universal C-ABI / &lt;code&gt;flutter_rust_bridge&lt;/code&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#239B56&quot; style=&quot;font-size:15px;&quot;&gt;&amp;#9632;&lt;/font&gt; &lt;b&gt;Layer 2 (Middle-Lower):&lt;/b&gt; TFLite AI Isolate &amp;amp; Adapter&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size:15px;&quot;&gt;&amp;#9635;&lt;/font&gt; &lt;b&gt;Path C Gate (Dashed):&lt;/b&gt; 0 ms OSI Caveat Manual Pass-Through&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#0E7490&quot; style=&quot;font-size:15px;&quot;&gt;&amp;#9632;&lt;/font&gt; &lt;b&gt;SAP-1 Band (L1 ↔ L2):&lt;/b&gt; Async Zero-Copy Dart Isolate Channel&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2E6295&quot; style=&quot;font-size:15px;&quot;&gt;&amp;#9632;&lt;/font&gt; &lt;b&gt;Layer 1 (Bottom):&lt;/b&gt; Flutter Thin UI Shell &amp;amp; SQLite&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#B91C1C&quot; style=&quot;font-size:15px;&quot;&gt;&amp;#9632;&lt;/font&gt; &lt;b&gt;Invariant Box:&lt;/b&gt; Cross-Platform Portability Guarantees&lt;br&gt;&lt;br&gt;&lt;b&gt;Signal Flow Directions:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;&lt;b&gt;&amp;#8593; Solid Blue / Violet:&lt;/b&gt;&lt;/font&gt; Upward Control Requests (L1 → L2 → L3)&lt;br&gt;&lt;font color=&quot;#047857&quot;&gt;&lt;b&gt;&amp;#8593; Dashed Green:&lt;/b&gt;&lt;/font&gt; OSI Caveat Pass-Through (0 ms ML Skip)&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;&lt;b&gt;&amp;#8595; Solid Amber / Teal:&lt;/b&gt;&lt;/font&gt; Downward Telemetry &amp;amp; Route Events (L3 → L2 → L1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.5;fontColor=#1E293B;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=12;fontSize=11;" vertex="1" parent="1">
            <mxGeometry x="1925" y="690" width="435" height="550" as="geometry" />
          </mxCell>
          <mxCell id="p2_budget_box" value="&lt;b style=&quot;font-size:13.5px;&quot;&gt;ABI Layout &amp;amp; Latency Contract Summary&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;#[repr(C)] ABI Struct Footprints (SAP-2):&lt;/b&gt;&lt;br&gt;• &lt;code&gt;BiquadFilterType&lt;/code&gt;: &lt;b&gt;1 B&lt;/b&gt; (&lt;code&gt;u8&lt;/code&gt; enum: 0, 1, 2)&lt;br&gt;• &lt;code&gt;BiquadBandSpec&lt;/code&gt;: &lt;b&gt;32 B&lt;/b&gt; (4×&lt;code&gt;u8&lt;/code&gt; + 3×&lt;code&gt;f64&lt;/code&gt;)&lt;br&gt;• &lt;code&gt;EqParameterFrame&lt;/code&gt;: &lt;b&gt;240 B&lt;/b&gt; (7 bands + preamp + flags + rate)&lt;br&gt;• &lt;code&gt;BiquadCoeffs&lt;/code&gt;: &lt;b&gt;40 B&lt;/b&gt; (5×&lt;code&gt;f64&lt;/code&gt; RBJ coefficients)&lt;br&gt;• &lt;code&gt;EqMathTelemetryFrame&lt;/code&gt;: &lt;code&gt;coeffs[7]&lt;/code&gt; + 2×&lt;code&gt;512 f32&lt;/code&gt; curves + scalars&lt;br&gt;&lt;br&gt;&lt;b&gt;Execution &amp;amp; Channel Budgets:&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Path A / B (INT8 TFLite):&lt;/b&gt; Isolate off-main-thread (&amp;lt; 2 ms)&lt;br&gt;• &lt;b&gt;Path C (Manual Override):&lt;/b&gt; &lt;b&gt;0 ms&lt;/b&gt; TFLite overhead&lt;br&gt;• &lt;b&gt;SAP-1 Buffer Transfer:&lt;/b&gt; Zero-copy &lt;code&gt;TransferableTypedData&lt;/code&gt;&lt;br&gt;• &lt;b&gt;L1 Visualizer Target:&lt;/b&gt; 60 fps (16.6 ms UI frame budget)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=1.5;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=12;fontSize=11;" vertex="1" parent="1">
            <mxGeometry x="1925" y="1265" width="435" height="355" as="geometry" />
          </mxCell>
