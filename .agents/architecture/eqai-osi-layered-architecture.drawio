          <mxCell id="p3_leg_sap3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#78350F;fontSize=10;" value="&lt;b&gt;SAP-3 HAL Contract&lt;/b&gt;&lt;br&gt;Trait &amp;amp; C-ABI VTable" vertex="1">
