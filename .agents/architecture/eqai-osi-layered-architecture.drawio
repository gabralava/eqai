  <diagram id="osi-hal-if" name="3. SAP-3 Universal OS Audio HAL (L3-L4)">
      <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1650" math="0" shadow="0">
        <root>
          <mxCell id="0" />
          <mxCell id="1" parent="0" />
  
          <mxCell id="p3_title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#0B4884;strokeWidth=2;fontColor=#052E56;align=left;spacingLeft=20;verticalAlign=middle;" value="&lt;b style=&quot;font-size:19px;&quot;&gt;Page 3 — SAP-3: Universal OS Audio HAL Interface (Layer 3 &amp;lt;-&amp;gt; Layer 4 Cross-Platform Isolation)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334E68;&quot;&gt;Dual-Mode Hardware Abstraction Layer decoupling the OS-agnostic Rust DSP Engine (Layer 3) from swappable OS Audio Subsystems (Layer 4: Android MVP, iOS, Windows, Linux) — Zero impact on Layers 1, 2, or 3.&lt;/span&gt;" vertex="1">
            <mxGeometry x="40" y="20" width="2320" height="72" as="geometry" />
          </mxCell>
  
          <mxCell id="p3_l4_container" parent="1" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;dashed=1;dashPattern=8 4;fillColor=#F8FAFC;strokeColor=#334155;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=14;fontColor=#0F172A;" value="&lt;b&gt;LAYER 4 (TOP-MOST): OS Audio Subsystem Layer — Swappable Platform Adapters Implementing SAP-3&lt;/b&gt;" vertex="1">
            <mxGeometry x="40" y="108" width="2320" height="482" as="geometry" />
          </mxCell>
  
          <mxCell id="p3_l4_android_os" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=1.5;fontColor=#14532D;align=left;spacing=10;verticalAlign=top;fontSize=11;" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Android OS Audio Server &amp;amp; Route Broadcasts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#166534;&quot;&gt;[OS Protected Mixer + AudioManager]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&amp;bull; &lt;b&gt;DynamicsProcessing&lt;/b&gt; (&lt;code&gt;sessionId = 0&lt;/code&gt;) runs in Android AudioFlinger&lt;br&gt;&amp;bull; &lt;code&gt;ACTION_HEADSET_PLUG&lt;/code&gt; &amp;amp; Bluetooth ACL broadcasts emit route &amp;amp; device changes" vertex="1">
            <mxGeometry x="65" y="152" width="545" height="118" as="geometry" />
          </mxCell>
          <mxCell id="p3_l4_android" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B5E20;strokeColor=#0F3D14;strokeWidth=2;fontColor=#FFFFFF;align=left;spacing=12;verticalAlign=top;fontSize=11;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Adapter 1 — Android OS Adapter [MVP ACTIVE]&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#BBF7D0;&quot;&gt;Capability Mode A: Parameter-Driven System DSP | Rust JNI (jni-rs)&lt;/span&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Implements &lt;b&gt;SAP-3&lt;/b&gt; &lt;code&gt;UniversalSystemAudioHal&lt;/code&gt; in &lt;b&gt;Mode A&lt;/b&gt;&lt;br&gt;&amp;bull; Translates &lt;code&gt;HalEqState&lt;/code&gt; (&lt;b&gt;7 bands + preamp_db&lt;/b&gt;) into direct JNI calls on &lt;code&gt;android.media.audiofx.DynamicsProcessing&lt;/code&gt; (&lt;code&gt;sessionId = 0&lt;/code&gt;):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;ndash; &lt;code&gt;setInputGainAllChannelsTo(preamp_db)&lt;/code&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;ndash; &lt;code&gt;setPreEqBandAllChannelsTo(0..6)&lt;/code&gt; &amp;amp; &lt;code&gt;setEnabled(enabled)&lt;/code&gt;&lt;br&gt;&amp;bull; Maps wired/BT device broadcasts into &lt;code&gt;HalRouteEvent&lt;/code&gt; down SAP-3" vertex="1">
            <mxGeometry x="65" y="294" width="545" height="276" as="geometry" />
          </mxCell>
  
          <mxCell id="p3_l4_ios_os" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=1.5;fontColor=#1E3A8A;align=left;spacing=10;verticalAlign=top;fontSize=11;" value="&lt;b style=&quot;font-size:12px;&quot;&gt;iOS / macOS CoreAudio &amp;amp; AVAudioSession&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#1E40AF;&quot;&gt;[Real-Time Audio Render Thread]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Strict real-time render block: zero allocations, zero locks, zero Obj-C calls&lt;br&gt;&amp;bull; &lt;code&gt;AVAudioSessionRouteChangeNotification&lt;/code&gt; reports device &amp;amp; sample rate" vertex="1">
            <mxGeometry x="640" y="152" width="545" height="118" as="geometry" />
          </mxCell>
          <mxCell id="p3_l4_ios" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E40AF;strokeColor=#1E3A8A;strokeWidth=2;fontColor=#FFFFFF;align=left;spacing=12;verticalAlign=top;fontSize=11;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Adapter 2 — iOS / macOS Adapter [TARGET EXPANSION]&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#BFDBFE;&quot;&gt;Capability Mode B: Real-Time PCM Callback | AUv3 / AVAudioEngine&lt;/span&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Implements &lt;b&gt;SAP-3&lt;/b&gt; inside an &lt;b&gt;AUv3 Audio Unit Extension&lt;/b&gt; / &lt;code&gt;AVAudioEngine&lt;/code&gt; (&lt;code&gt;AUAudioUnit&lt;/code&gt; internalRenderBlock)&lt;br&gt;&amp;bull; On &lt;code&gt;commit_parametric_state()&lt;/code&gt;, atomically swaps the &lt;b&gt;7 BiquadCoeffs&lt;/b&gt; in a lock-free ring/atomic buffer shared via &lt;b&gt;App Group IPC&lt;/b&gt;&lt;br&gt;&amp;bull; On every CoreAudio render cycle, invokes L3&amp;apos;s &lt;code&gt;process_realtime_pcm_f32()&lt;/code&gt; to filter float32 PCM samples with zero allocations" vertex="1">
            <mxGeometry x="640" y="294" width="545" height="276" as="geometry" />
          </mxCell>
  
          <mxCell id="p3_l4_windows_os" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=1.5;fontColor=#1E3A8A;align=left;spacing=10;verticalAlign=top;fontSize=11;" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Windows WASAPI Audio Engine &amp;amp; Endpoints&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#1E40AF;&quot;&gt;[AudioGraph / Device Endpoint Pump]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Hosts system-wide Endpoint/Stream APO (&lt;code&gt;eAPO / sAPO&lt;/code&gt;) on float32 stream&lt;br&gt;&amp;bull; &lt;code&gt;IMMNotificationClient&lt;/code&gt; detects endpoint switch &amp;amp; sample rate changes" vertex="1">
            <mxGeometry x="1215" y="152" width="545" height="118" as="geometry" />
          </mxCell>
          <mxCell id="p3_l4_windows" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E40AF;strokeColor=#1E3A8A;strokeWidth=2;fontColor=#FFFFFF;align=left;spacing=12;verticalAlign=top;fontSize=11;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Adapter 3 — Windows Adapter [TARGET EXPANSION]&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#BFDBFE;&quot;&gt;Capability Mode B: Real-Time PCM Callback | Windows APO / WASAPI&lt;/span&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Implements &lt;b&gt;SAP-3&lt;/b&gt; as a &lt;b&gt;Windows Audio Processing Object&lt;/b&gt; (&lt;code&gt;IAudioProcessingObjectRealtime&lt;/code&gt; / &lt;code&gt;WASAPI&lt;/code&gt; system-wide sAPO/eAPO DLL)&lt;br&gt;&amp;bull; Invokes &lt;b&gt;SAP-3&lt;/b&gt; &lt;code&gt;process_realtime_pcm_f32()&lt;/code&gt; directly inside &lt;code&gt;APOProcess()&lt;/code&gt; on Windows &lt;code&gt;float32&lt;/code&gt; audio frames&lt;br&gt;&amp;bull; Updates coefficients lock-free via &lt;code&gt;commit_parametric_state()&lt;/code&gt; over shared memory / COM" vertex="1">
            <mxGeometry x="1215" y="294" width="545" height="276" as="geometry" />
          </mxCell>
  
          <mxCell id="p3_l4_linux_os" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=1.5;fontColor=#1E3A8A;align=left;spacing=10;verticalAlign=top;fontSize=11;" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Linux PipeWire Daemon / ALSA PCM Stack&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#1E40AF;&quot;&gt;[PipeWire Graph + ALSA + udev]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Routes float32 audio graph buffers or hosts native &lt;code&gt;filter-chain&lt;/code&gt; biquads&lt;br&gt;&amp;bull; PipeWire registry / udev reports BT A2DP/LE Audio &amp;amp; USB DAC hotplug" vertex="1">
            <mxGeometry x="1790" y="152" width="545" height="118" as="geometry" />
          </mxCell>
          <mxCell id="p3_l4_linux" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E40AF;strokeColor=#1E3A8A;strokeWidth=2;fontColor=#FFFFFF;align=left;spacing=12;verticalAlign=top;fontSize=11;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Adapter 4 — Linux Adapter [TARGET EXPANSION]&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#BFDBFE;&quot;&gt;Capability Mode B (or Mode A) | PipeWire / LADSPA / LV2 / ALSA&lt;/span&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Implements &lt;b&gt;SAP-3&lt;/b&gt; as a &lt;b&gt;PipeWire Filter-Chain module&lt;/b&gt; (&lt;code&gt;spa_node&lt;/code&gt; / LADSPA / LV2 plugin) or &lt;b&gt;ALSA &lt;code&gt;pcm_extplug&lt;/code&gt;&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;b&gt;Mode B:&lt;/b&gt; Calls &lt;b&gt;SAP-3&lt;/b&gt; &lt;code&gt;process_realtime_pcm_f32()&lt;/code&gt; on PipeWire audio graph buffers&lt;br&gt;&amp;bull; &lt;b&gt;Mode A (Optional):&lt;/b&gt; Pushes &lt;code&gt;[BiquadCoeffs; 7]&lt;/code&gt; via &lt;code&gt;commit_parametric_state()&lt;/code&gt; to PipeWire&amp;apos;s built-in &lt;code&gt;filter-chain&lt;/code&gt; biquad nodes" vertex="1">
            <mxGeometry x="1790" y="294" width="545" height="276" as="geometry" />
          </mxCell>
  
          <mxCell id="p3_sap3_container" parent="1" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=2.5;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=14;fontColor=#78350F;" value="&lt;b&gt;INTERFACE BOUNDARY SAP-3 (L3 &amp;lt;-&amp;gt; L4): UniversalAudioHalTrait &amp;amp; C-ABI VTable — OS-Agnostic Hardware Abstraction Contract&lt;/b&gt;" vertex="1">
            <mxGeometry x="40" y="640" width="2320" height="420" as="geometry" />
          </mxCell>
  
          <mxCell id="p3_sap3_mode_a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;align=left;spacing=12;verticalAlign=top;fontSize=11;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Capability Mode A: Parameter-Driven System DSP&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#92400E;&quot;&gt;Why Needed: OS owns protected audio mixer&lt;/i&gt;&lt;br&gt;&lt;br&gt;&amp;bull; OS runs audio mixing in a privileged system server and accepts parametric band specifications (&lt;code&gt;[BiquadBandSpec; 7] + preamp_db&lt;/code&gt;) or coefficients (&lt;code&gt;[BiquadCoeffs; 7]&lt;/code&gt;).&lt;br&gt;&lt;br&gt;&amp;bull; Zero PCM audio frames cross into EQAI.&lt;br&gt;&amp;bull; L3 only computes math &amp;amp; pushes &lt;code&gt;HalEqState&lt;/code&gt; up via &lt;code&gt;commit_parametric_state()&lt;/code&gt;.&lt;br&gt;&lt;br&gt;&amp;bull; &lt;b&gt;Used by:&lt;/b&gt; Android (&lt;code&gt;DynamicsProcessing&lt;/code&gt;, &lt;code&gt;sessionId = 0&lt;/code&gt;) &amp;amp; optional PipeWire biquad nodes." vertex="1">
            <mxGeometry x="65" y="685" width="525" height="350" as="geometry" />
          </mxCell>
  
          <mxCell id="p3_sap3_contract" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=2.5;fontColor=#1E293B;align=left;spacing=14;verticalAlign=top;fontSize=11;" value="&lt;b style=&quot;font-size:14px;color:#92400E;&quot;&gt;SAP-3 Contract: pub trait UniversalSystemAudioHal: Send + Sync &amp;amp; C-ABI VTable (eqai_hal_vtable)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Capability Discovery:&lt;/b&gt;&lt;br&gt;&lt;code&gt;fn capabilities(&amp;amp;self) -&amp;gt; HalCapabilities { supports_system_parametric_dsp: bool, supports_pcm_stream_callback: bool, min_sample_rate: u32, max_bands: u8 }&lt;/code&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Session Lifecycle:&lt;/b&gt;&lt;br&gt;&lt;code&gt;fn init_session(&amp;amp;mut self, config: HalSessionConfig) -&amp;gt; Result&amp;lt;HalSessionHandle, HalError&amp;gt;&lt;/code&gt;&lt;br&gt;&lt;code&gt;fn shutdown(&amp;amp;mut self) -&amp;gt; Result&amp;lt;(), HalError&amp;gt;&lt;/code&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Upward Parameter / Coefficient Push (Mode A Push &amp;amp; Mode B Atomic Coeff Swap):&lt;/b&gt;&lt;br&gt;&lt;code&gt;fn commit_parametric_state(&amp;amp;mut self, state: &amp;amp;HalEqState /* [BiquadBandSpec; 7], [BiquadCoeffs; 7], preamp_db: f32, enabled: bool */) -&amp;gt; Result&amp;lt;(), HalError&amp;gt;&lt;/code&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;4. Real-Time Audio Thread Callback (Mode B: Lock-Free PCM Callback Provided by L3 to L4):&lt;/b&gt;&lt;br&gt;&lt;code&gt;extern &quot;C&quot; fn process_realtime_pcm_f32(ctx: *mut DspCascadeState, in_out_pcm: *mut f32, frames: u32, channels: u16, sample_rate: u32) -&amp;gt; i32&lt;/code&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;5. Downward Hardware Route &amp;amp; Sample-Rate Telemetry (L4 -&amp;gt; L3):&lt;/b&gt;&lt;br&gt;&lt;code&gt;fn subscribe_route_events(&amp;amp;mut self, sink: HalRouteEventCallback) -&amp;gt; Result&amp;lt;(), HalError&amp;gt;&lt;/code&gt;" vertex="1">
            <mxGeometry x="630" y="685" width="1140" height="350" as="geometry" />
          </mxCell>
  
          <mxCell id="p3_sap3_mode_b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;align=left;spacing=12;verticalAlign=top;fontSize=11;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Capability Mode B: Buffer-Driven Real-Time PCM&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#92400E;&quot;&gt;Why Needed: OS routes raw float32 PCM through plugin&lt;/i&gt;&lt;br&gt;&lt;br&gt;&amp;bull; OS loads a native plugin/extension and routes interleaved/planar &lt;code&gt;&amp;amp;mut [f32]&lt;/code&gt; PCM audio buffers.&lt;br&gt;&lt;br&gt;&amp;bull; L4 invokes L3&amp;apos;s lock-free &lt;b&gt;Direct Form II Transposed 7-Band Biquad Cascade&lt;/b&gt; via &lt;code&gt;process_realtime_pcm_f32()&lt;/code&gt;.&lt;br&gt;&lt;br&gt;&amp;bull; &lt;code&gt;commit_parametric_state()&lt;/code&gt; swaps coefficients atomically without locks.&lt;br&gt;&amp;bull; &lt;b&gt;Used by:&lt;/b&gt; iOS (&lt;code&gt;AUv3&lt;/code&gt;), Windows (&lt;code&gt;APO / WASAPI&lt;/code&gt;), Linux (&lt;code&gt;PipeWire / LADSPA / ALSA&lt;/code&gt;)." vertex="1">
            <mxGeometry x="1810" y="685" width="525" height="350" as="geometry" />
          </mxCell>
  
          <mxCell id="p3_l3_container" parent="1" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;dashed=1;dashPattern=8 4;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=14;fontColor=#134E4A;" value="&lt;b&gt;LAYER 3 (BELOW SAP-3): Rust Mathematical &amp;amp; DSP Engine Internals (libeqai_math) — 100% OS-Agnostic&lt;/b&gt;" vertex="1">
            <mxGeometry x="40" y="1115" width="2320" height="355" as="geometry" />
          </mxCell>
  
          <mxCell id="p3_l3_negotiator" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F766E;strokeColor=#115E59;strokeWidth=2;fontColor=#FFFFFF;align=left;spacing=12;verticalAlign=top;fontSize=11;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;HalAdapterRegistry &amp;amp; CapabilityNegotiator&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#CCFBF1;&quot;&gt;Runtime Capability Dispatch &amp;amp; Route Event Handler&lt;/span&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Inspects &lt;code&gt;L4.capabilities()&lt;/code&gt; at startup via &lt;code&gt;init_session()&lt;/code&gt;:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;ndash; &lt;b&gt;If &lt;code&gt;supports_system_parametric_dsp == true&lt;/code&gt; (Android):&lt;/b&gt; routes &lt;code&gt;HalEqState&lt;/code&gt; directly to &lt;code&gt;commit_parametric_state()&lt;/code&gt;; bypasses local PCM cascade.&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;ndash; &lt;b&gt;If &lt;code&gt;supports_pcm_stream_callback == true&lt;/code&gt; (iOS / Windows / Linux):&lt;/b&gt; arms the lock-free 7-Band Biquad Cascade &amp;amp; binds &lt;code&gt;process_realtime_pcm_f32()&lt;/code&gt;.&lt;br&gt;&amp;bull; Subscribes to &lt;code&gt;HalRouteEvent&lt;/code&gt; callbacks, updates active &lt;code&gt;sample_rate (fs)&lt;/code&gt;, and emits &lt;code&gt;L3_TelemetrySDU&lt;/code&gt; down SAP-2 to L2 &amp;amp; L1." vertex="1">
            <mxGeometry x="65" y="1160" width="705" height="285" as="geometry" />
          </mxCell>
  
          <mxCell id="p3_l3_dsp_cascade" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#115E59;strokeColor=#042F2E;strokeWidth=2;fontColor=#FFFFFF;align=left;spacing=12;verticalAlign=top;fontSize=11;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Lock-Free 7-Band Direct Form II Transposed Biquad Cascade&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#99F6E4;&quot;&gt;AtomicCoeffSwapBuffer + Real-Time PCM Filter (Mode B Execution Core)&lt;/span&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Executes inside &lt;code&gt;extern &quot;C&quot; fn process_realtime_pcm_f32(ctx, in_out_pcm, frames, channels, fs)&lt;/code&gt;&lt;br&gt;&amp;bull; &lt;b&gt;AtomicCoeffSwapBuffer:&lt;/b&gt; double-buffered &lt;code&gt;Acquire/Release&lt;/code&gt; atomic swap of &lt;code&gt;[BiquadCoeffs; 7]&lt;/code&gt; &amp;amp; &lt;code&gt;preamp_linear&lt;/code&gt; — &lt;b&gt;zero mutexes, zero heap allocations, zero syscalls&lt;/b&gt; on the audio thread&lt;br&gt;&amp;bull; Per-channel state &lt;code&gt;[DspDelayLine; 7]&lt;/code&gt; runs DF-II Transposed recurrence:&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;code&gt;y[n] = b0*x[n] + w1; w1 = b1*x[n] - a1*y[n] + w2; w2 = b2*x[n] - a2*y[n]&lt;/code&gt;&lt;br&gt;&amp;bull; Includes denormal flush-to-zero &amp;amp; smooth per-sample gain ramping" vertex="1">
            <mxGeometry x="820" y="1160" width="760" height="285" as="geometry" />
          </mxCell>
  
          <mxCell id="p3_l3_rbj_math" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F766E;strokeColor=#115E59;strokeWidth=2;fontColor=#FFFFFF;align=left;spacing=12;verticalAlign=top;fontSize=11;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;7-Band RBJ Biquad Math, Preamp Guard &amp;amp; 512-Pt FR Evaluator&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#CCFBF1;&quot;&gt;Identical Mathematical Source of Truth Across All 4 Operating Systems&lt;/span&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Receives &lt;code&gt;L2_EqFramePDU&lt;/code&gt; (&lt;code&gt;[BiquadBandSpec; 7]&lt;/code&gt;) across &lt;b&gt;SAP-2&lt;/b&gt; (&lt;code&gt;flutter_rust_bridge&lt;/code&gt;)&lt;br&gt;&amp;bull; Computes exact Robert Bristow-Johnson (RBJ) biquad coefficients (&lt;code&gt;b0, b1, b2, a1, a2&lt;/code&gt;) for Peak Bell, Low Shelf, High Shelf using &lt;code&gt;L4 sample_rate (fs)&lt;/code&gt;&lt;br&gt;&amp;bull; Evaluates 512-pt log-scale composite FR curve (20 Hz - 20 kHz, dB) &amp;amp; computes safe auto-preamp clipping guard (&lt;code&gt;preamp_db = -max(0, peak_db)&lt;/code&gt;)&lt;br&gt;&amp;bull; Crossfade interpolator (15 ms manual / 50 ms AI switch) packages &lt;code&gt;HalEqState&lt;/code&gt;" vertex="1">
            <mxGeometry x="1630" y="1160" width="705" height="285" as="geometry" />
          </mxCell>
  
          <mxCell id="p3_isolation_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;strokeWidth=2;fontColor=#1E3A8A;align=left;spacing=12;verticalAlign=top;fontSize=11;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Cross-Platform Isolation Guarantee (Why SAP-3 Protects Layers 1, 2, and 3)&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;b&gt;Zero Ripple Effect:&lt;/b&gt; Swapping Layer 4 (Android &lt;code&gt;DynamicsProcessing&lt;/code&gt; &amp;rarr; iOS &lt;code&gt;AUv3&lt;/code&gt; &amp;rarr; Windows &lt;code&gt;APO/WASAPI&lt;/code&gt; &amp;rarr; Linux &lt;code&gt;PipeWire/ALSA&lt;/code&gt;) requires &lt;b&gt;ZERO changes&lt;/b&gt; to Layer 3 (Rust DSP/Math), Layer 2 (TFLite AI Model &amp;amp; Manual Pass-Through Mux), or Layer 1 (Flutter UI Shell &amp;amp; SQLite).&lt;br&gt;&amp;bull; &lt;b&gt;Dual-Mode Universality:&lt;/b&gt; Whether an OS provides a protected system parametric DSP (Mode A) or raw float32 PCM callbacks (Mode B), &lt;b&gt;SAP-3&lt;/b&gt; normalizes both behind one contract while L3 guarantees identical RBJ math across every platform.&lt;br&gt;&amp;bull; &lt;b&gt;Strict OSI Layer Adjacency:&lt;/b&gt; Layer 4 communicates exclusively with Layer 3 across SAP-3 — never directly with Layer 2 or Layer 1." vertex="1">
            <mxGeometry x="40" y="1490" width="1240" height="140" as="geometry" />
          </mxCell>
  
          <mxCell id="p3_legend_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=12;fontColor=#0F172A;" value="&lt;b&gt;Legend — Component Roles &amp;amp; SAP-3 Signal Semantics&lt;/b&gt;" vertex="1">
            <mxGeometry x="1305" y="1490" width="1055" height="140" as="geometry" />
          </mxCell>
  
          <mxCell id="p3_leg_mvp" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B5E20;strokeColor=#0F3D14;fontColor=#FFFFFF;fontSize=10;" value="&lt;b&gt;Active MVP (Android)&lt;/b&gt;&lt;br&gt;Mode A Parameter DSP" vertex="1">
            <mxGeometry x="1320" y="1526" width="245" height="42" as="geometry" />
          </mxCell>
