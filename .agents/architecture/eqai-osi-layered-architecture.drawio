          <mxCell id="p1_edge_sap1_l2_up" edge="1" parent="1" source="p1_sap1_container" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0369A1;strokeWidth=2.5;endArrow=classic;endFill=1;fontColor=#0C4A6E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.22;exitY=0;exitDx=0;exitDy=0;entryX=0.22;entryY=1;entryDx=0;entryDy=0;" target="p1_l2_container" value="SendPort / ReceivePort Intent Dispatch">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
          <mxCell id="p1_edge_l2_sap1_down" edge="1" parent="1" source="p1_l2_container" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6D28D9;strokeWidth=2.5;dashed=1;endArrow=classic;endFill=1;fontColor=#5B21B6;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.78;exitY=1;exitDx=0;exitDy=0;entryX=0.78;entryY=0;entryDx=0;entryDy=0;" target="p1_sap1_container" value="Relayed 512-pt Curves &amp;amp; Headset State">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
          <mxCell id="p1_edge_l2_sap2_up" edge="1" parent="1" source="p1_l2_container" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0369A1;strokeWidth=2.5;endArrow=classic;endFill=1;fontColor=#0C4A6E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.22;exitY=0;exitDx=0;exitDy=0;entryX=0.22;entryY=1;entryDx=0;entryDy=0;" target="p1_sap2_container" value="submit_eq_frame(EqParameterFrame)">
            <mxGeometry relative="1" as="geometry" />
