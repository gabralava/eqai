          <mxCell id="p3_leg_l3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F766E;strokeColor=#115E59;fontColor=#FFFFFF;fontSize=10;" value="&lt;b&gt;Layer 3 Rust Core&lt;/b&gt;&lt;br&gt;OS-Agnostic DSP &amp;amp; Math" vertex="1">
            <mxGeometry x="2105" y="1526" width="240" height="42" as="geometry" />
          </mxCell>
  
          <mxCell id="p3_leg_ctrl" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" value="&lt;b&gt;Solid Dark Arrow:&lt;/b&gt; Control / Param Push (commit_parametric_state)" vertex="1">
            <mxGeometry x="1320" y="1576" width="335" height="40" as="geometry" />
          </mxCell>
          <mxCell id="p3_leg_pcm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;strokeWidth=1.5;dashed=1;fontColor=#1E3A8A;fontSize=10;" value="&lt;b&gt;Dashed Blue Arrow:&lt;/b&gt; Mode B PCM Callback (process_realtime_pcm_f32)" vertex="1">
            <mxGeometry x="1670" y="1576" width="350" height="40" as="geometry" />
