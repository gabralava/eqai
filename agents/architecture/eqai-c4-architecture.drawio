        <mxCell id="c3_leg_rust" value="&lt;b&gt;Rust Core Intermediary Component&lt;/b&gt;&lt;br/&gt;libeqai_math.so (flutter_rust_bridge &amp;amp; jni-rs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5CBA7;strokeColor=#B9770E;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
