          <mxGeometry x="2120" y="114" width="222" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c3_leg_ext" value="&lt;b&gt;External System&lt;/b&gt;&lt;br/&gt;Android DynamicsProcessing &amp;amp; Broadcasts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1878" y="176" width="222" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c3_leg_boundary" value="&lt;b&gt;Dashed Box: Runtime Boundary&lt;/b&gt;&lt;br/&gt;UI Shell / TFLite Isolate / Rust Core" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#F8FAFC;strokeColor=#444444;strokeWidth=1.5;fontColor=#222222;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2120" y="176" width="222" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c3_leg_note" value="Intermediary Pipeline: Flutter (Riverpod + CustomPainter) is a thin UI shell (no EQ MethodChannel). Both 7-band manual EQ adjustments and TFLite AI outputs route via flutter_rust_bridge into Rust (libeqai_math.so), which directly invokes Android DynamicsProcessing (sessionId = 0) via Rust JNI (jni-rs) and returns 512-pt Float32List curves for UI rendering." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="1878" y="234" width="464" height="76" as="geometry" />
        </mxCell>
        <mxCell id="c3_boundary_a" value="&lt;b&gt;Boundary A: Flutter Thin UI Shell (Presentation &amp;amp; Thin Shell Facade)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#F4F8FD;strokeColor=#2E6295;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontColor=#0B3B6E;" vertex="1" parent="1">
          <mxGeometry x="40" y="115" width="1780" height="445" as="geometry" />
        </mxCell>
        <mxCell id="c3_boundary_c" value="&lt;b&gt;Boundary C: Rust Mathematical Engine (libeqai_math.so — Core Intermediary)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#FEF9F3;strokeColor=#B9770E;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontColor=#7E5109;" vertex="1" parent="1">
          <mxGeometry x="470" y="640" width="910" height="705" as="geometry" />
        </mxCell>
        <mxCell id="c3_boundary_b" value="&lt;b&gt;Boundary B: On-Device AI Model (TFLite Background Isolate)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#F3FBF6;strokeColor=#239B56;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontColor=#186A3B;" vertex="1" parent="1">
          <mxGeometry x="1520" y="640" width="840" height="640" as="geometry" />
        </mxCell>
        <mxCell id="c3_ui_home" value="&lt;b&gt;Home &amp;amp; Profile Switcher UI&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Component: Flutter Widget]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;Master EQ toggle, active headphone card, A/B instant comparison, settings &amp;amp; onboarding." style="fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="65" y="160" width="390" height="155" as="geometry" />
        </mxCell>
        <mxCell id="c3_ui_tuning" value="&lt;b&gt;Manual &amp;amp; AI Command UI&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Component: Flutter Widget]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;Captures manual 7-band sliders/presets AND high-level AI sound commands (&amp;quot;More Bass&amp;quot;, &amp;quot;Richer Sound&amp;quot;, &amp;quot;Warmth&amp;quot;, &amp;quot;Clarity&amp;quot;)." style="fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="485" y="160" width="430" height="155" as="geometry" />
        </mxCell>
        <mxCell id="c3_ui_visualizer" value="&lt;b&gt;Interactive FR &amp;amp; EQ Curve Visualizer&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Component: Flutter CustomPainter (Native Canvas API)]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;Renders 60fps log-scale (20Hz-20kHz) dB chart and draggable 7-band EQ nodes using 512-pt Float32List curves returned by Rust." style="fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="945" y="160" width="430" height="155" as="geometry" />
        </mxCell>
        <mxCell id="c3_ui_search" value="&lt;b&gt;Headphone Search UI&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Component: Flutter Widget]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;Live fuzzy search across ~4,000 AutoEQ models (Over-Ear, In-Ear, TWS)." style="fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1405" y="160" width="390" height="155" as="geometry" />
        </mxCell>
        <mxCell id="c3_headset_listener" value="&lt;b&gt;HeadsetEventListener&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Component: Lightweight EventChannel + BroadcastReceiver]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;Listens ONLY for wired/Bluetooth headset plug/unplug and device names (ACTION_HEADSET_PLUG, Bluetooth ACL) so the shell can auto-select profiles." style="fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="65" y="385" width="360" height="155" as="geometry" />
        </mxCell>
        <mxCell id="c3_ui_dispatcher" value="&lt;b&gt;UIShellDispatcher (Thin Facade)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Component: Riverpod Controller (flutter_riverpod)]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;Thin routing facade — forwards 7-band manual EQ adjustments to Rust via flutter_rust_bridge, forwards high-level AI instructions + FR to AIModelDispatcher, and updates UI chart state with Rust&amp;apos;s 512-pt Float32List curve output. (Does NOT send EQ parameters to Android via MethodChannel!)" style="fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="475" y="385" width="790" height="155" as="geometry" />
        </mxCell>
        <mxCell id="c3_data_repos" value="&lt;b&gt;Headphone &amp;amp; Profile Repositories&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Component: Dart Data Repositories (drift / sqlite3)]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;Queries bundled read-only SQLite (FTS5) AutoEQ database (binary FLOAT32 BLOB curves) and persists saved EQProfiles, Bluetooth mappings, and cached 7-band inference results in local SQLite (drift)." style="fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1315" y="385" width="480" height="155" as="geometry" />
        </mxCell>
        <mxCell id="c3_store_assets" value="&lt;b&gt;Bundled Asset Store&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Container: SQLite FTS5 .db &amp;amp; INT8 .tflite Assets]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;Read-only packaged ~4,000 AutoEQ headphone FR measurements (SQLite FTS5 + binary FLOAT32 BLOBs) and quantized INT8 .tflite neural network models." style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1870" y="380" width="480" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c3_ext_bt_service" value="&lt;b&gt;Android OS Bluetooth &amp;amp; Headset Service&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[External System: Broadcasts]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;System broadcast service emitting ACTION_HEADSET_PLUG and Bluetooth ACL connection events and device names." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="675" width="385" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c3_rust_cascade" value="&lt;b&gt;CascadeFRCurveEvaluator&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Component: Rust Module]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;Computes 512-pt Float32List composite 7-band EQ &amp;amp; compensated FR curves (dB) and returns them to Flutter UI Shell via flutter_rust_bridge for chart visualization." style="fillColor=#F5CBA7;strokeColor=#B9770E;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="495" y="685" width="405" height="160" as="geometry" />
        </mxCell>
        <mxCell id="c3_rust_ffi_rx" value="&lt;b&gt;FfiCommandReceiver&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Component: Rust FFI Entrypoint (flutter_rust_bridge)]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;Receives 7-band manual EQ settings from Flutter UI Shell and 7-band AI-predicted EQ settings from On-Device AI Model via flutter_rust_bridge." style="fillColor=#F5CBA7;strokeColor=#B9770E;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="940" y="685" width="415" height="160" as="geometry" />
        </mxCell>
        <mxCell id="c3_rust_biquad" value="&lt;b&gt;BiquadCoefficientEngine&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Component: Rust Module (RBJ Cookbook)]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;Calculates b0, b1, b2, a1, a2 for 7 biquad bands (Peak Bell, Low Shelf, and High Shelf filters)." style="fillColor=#F5CBA7;strokeColor=#B9770E;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="495" y="915" width="405" height="160" as="geometry" />
        </mxCell>
        <mxCell id="c3_rust_interp" value="&lt;b&gt;ParameterInterpolator &amp;amp; PreampGuard&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Component: Rust Module]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;Smooths crossfade transitions (click-free switching) and computes auto-preamp headroom to prevent clipping." style="fillColor=#F5CBA7;strokeColor=#B9770E;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="940" y="915" width="415" height="160" as="geometry" />
        </mxCell>
        <mxCell id="c3_rust_android_driver" value="&lt;b&gt;AndroidAudioSystemDriver&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Component: Rust JNI Audio Caller (jni-rs)]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;Directly invokes Android android.media.audiofx.DynamicsProcessing methods via Rust JNI (jni-rs) on global sessionId = 0 (MODIFY_AUDIO_SETTINGS) to apply 7-band parametric EQ and input preamp gain." style="fillColor=#F5CBA7;strokeColor=#B9770E;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="615" y="1145" width="620" height="175" as="geometry" />
        </mxCell>
        <mxCell id="c3_ml_base_predictor" value="&lt;b&gt;Base EQ TFLite Predictor&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Component: TFLite Interpreter (1D CNN + MLP)]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;Predicts 7 baseline biquad bands [{freq, gain, Q}] (7x3 = 21 outputs) from [Headphone FR (512) + Target FR (512)]." style="fillColor=#A9DFBF;strokeColor=#239B56;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1545" y="690" width="380" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c3_ml_abstract_predictor" value="&lt;b&gt;Abstract Sound Tuning Predictor&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Component: TFLite Interpreter (Semantic Delta Model)]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;Maps high-level user commands (&amp;quot;More Bass&amp;quot;, &amp;quot;Richer Sound&amp;quot;, &amp;quot;Warmth&amp;quot;, &amp;quot;Clarity&amp;quot;) + FR/7-band state into 7-band EQ parameter adjustments Δ[{freq, gain, Q}] (7x3 = 21)." style="fillColor=#A9DFBF;strokeColor=#239B56;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1955" y="690" width="380" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c3_ml_ffi_forwarder" value="&lt;b&gt;AI-to-Rust FFI Forwarder&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Component: TFLite Isolate Output Bridge (flutter_rust_bridge)]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;Feeds AI-computed 7-band EQ parameters ([{freq, gain, Q}]) directly into Rust (FfiCommandReceiver) via flutter_rust_bridge and notifies the UI Shell with updated curve/band state." style="fillColor=#A9DFBF;strokeColor=#239B56;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1615" y="990" width="650" height="210" as="geometry" />
        </mxCell>
        <mxCell id="c3_ext_android_audio" value="&lt;b&gt;Android OS Audio Subsystem&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[External System: Android DynamicsProcessing API (sessionId = 0)]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;Global Android audio output session (sessionId = 0) executing system-wide 7-band parametric EQ and input preamp gain." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="625" y="1430" width="600" height="155" as="geometry" />
        </mxCell>
        <mxCell id="c3_store_local_db" value="&lt;b&gt;Local User Database&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Container: SQLite (drift / sqlite3)]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;Stores user EQProfiles, Bluetooth device mappings, cached 7-band ML inference outputs, and preferences in local SQLite." style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;spacing=8;" vertex="1" parent="1">
