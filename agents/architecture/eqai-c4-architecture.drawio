<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="c1-context" name="C1 - System Context">
    <mxGraphModel dx="1669" dy="917" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1_title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#0B4884;strokeWidth=2;fontColor=#052E56;align=left;spacingLeft=20;" value="&lt;b style=&quot;font-size:18px&quot;&gt;C1 - System Context: EQAI Mobile Equalizer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#334E68&quot;&gt;Offline AI-Powered 7-Band Parametric Equalizer (Android App + Offline Build-Time ML &amp;amp; Data Pipeline)&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="1510" x="50" y="30" as="geometry" />
        </mxCell>
        <mxCell id="c1_engineer" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;arcSize=10;" value="&lt;b style=&quot;font-size:14px&quot;&gt;ML / Data Engineer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Executes the offline build-time data pipeline to parse AutoEQ measurements and train/quantize the TFLite neural networks." vertex="1">
          <mxGeometry height="175" width="350" x="50" y="150" as="geometry" />
        </mxCell>
        <mxCell id="c1_user" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;arcSize=10;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Audiophile / Mobile User&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Selects headphone model from ~4,000 models, enables system-wide EQ, adjusts 7 manual EQ sliders or gives high-level AI sound instructions (&amp;quot;More Bass&amp;quot;, &amp;quot;Richer Sound&amp;quot;, &amp;quot;Warmth&amp;quot;, &amp;quot;Clarity&amp;quot;), and switches profiles." vertex="1">
          <mxGeometry height="175" width="380" x="640" y="150" as="geometry" />
        </mxCell>
        <mxCell id="c1_ml_pipeline" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#FFFFFF;arcSize=8;dashed=1;" value="&lt;b style=&quot;font-size:14px&quot;&gt;EQAI Offline ML &amp;amp; Data Pipeline&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Software System: Python CLI, TensorFlow / Keras, SciPy, MLflow]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Offline build-time system that parses AutoEQ frequency responses into Apache Parquet &amp;amp; HDF5, normalizes to a 512-point logarithmic grid (20Hz-20kHz), trains the 1D CNN + MLP 7-band EQ model and Abstract Sound Tuning model, applies INT8 quantization (&amp;lt;1 MB), and packages .tflite models + indexed SQLite AutoEQ database (FTS5 + FLOAT32 BLOBs) into app assets." vertex="1">
          <mxGeometry height="250" width="350" x="50" y="460" as="geometry" />
        </mxCell>
        <mxCell id="c1_eqai_app" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;arcSize=8;" value="&lt;b style=&quot;font-size:14px&quot;&gt;EQAI Mobile Application&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Software System: Android App (Flutter / Riverpod, TFLite AI, Rust Math Engine)]&lt;/font&gt;&lt;br&gt;&lt;br&gt;100% offline on-device intelligent parametric equalizer (7 biquad bands). Flutter (Material 3 / Riverpod / CustomPainter) acts strictly as a thin UI shell; on-device TFLite translates headphone FR &amp;amp; high-level user instructions (&amp;quot;More Bass&amp;quot;, &amp;quot;Richer Sound&amp;quot;, &amp;quot;Warmth&amp;quot;, &amp;quot;Clarity&amp;quot;) into 7-band EQ parameters; and the Rust Mathematical Engine (flutter_rust_bridge + jni-rs) acts as the central intermediary processing manual &amp;amp; AI EQ parameters and calling Android DynamicsProcessing directly." vertex="1">
          <mxGeometry height="250" width="380" x="640" y="460" as="geometry" />
        </mxCell>
        <mxCell id="c1_bt_service" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;arcSize=8;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Android OS Bluetooth &amp;amp; Headset Service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[External System: Android AudioManager &amp;amp; BroadcastReceiver]&lt;/font&gt;&lt;br&gt;&lt;br&gt;System broadcast service emitting wired (ACTION_HEADSET_PLUG) and Bluetooth headphone connection events and device names." vertex="1">
          <mxGeometry height="176" width="300" x="1260" y="497" as="geometry" />
        </mxCell>
        <mxCell id="c1_autoeq" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;arcSize=8;" value="&lt;b style=&quot;font-size:14px&quot;&gt;AutoEQ GitHub Repository&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[External System: Git / CSV &amp;amp; JSON Dataset]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Open-source database of ~4,000 measured headphone frequency responses and reference equalization curves." vertex="1">
          <mxGeometry height="170" width="350" x="50" y="845" as="geometry" />
        </mxCell>
        <mxCell id="c1_audio_sub" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;arcSize=8;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Android OS Audio Subsystem&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[External System: Android DynamicsProcessing API (sessionId = 0)]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Global Android audio session (sessionId = 0) that applies 7-band parametric EQ filters and preamp across all device audio output." vertex="1">
          <mxGeometry height="170" width="380" x="640" y="845" as="geometry" />
        </mxCell>
        <mxCell id="c1_legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#CCCCCC;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=12;spacingRight=12;fontColor=#222222;fontSize=11;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Legend (C4 Model - System Context)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#08427B&quot; style=&quot;font-size:14px&quot;&gt;&amp;#9632;&lt;/font&gt; &lt;b&gt;Person&lt;/b&gt; (Mobile User / ML Engineer)&lt;br&gt;&lt;font color=&quot;#1168BD&quot; style=&quot;font-size:14px&quot;&gt;&amp;#9632;&lt;/font&gt; &lt;b&gt;Target Software System&lt;/b&gt; (EQAI Mobile App)&lt;br&gt;&lt;font color=&quot;#2E7D32&quot; style=&quot;font-size:14px&quot;&gt;&amp;#9632;&lt;/font&gt; &lt;b&gt;Build-Time System&lt;/b&gt; (Offline ML Pipeline, dashed)&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:14px&quot;&gt;&amp;#9632;&lt;/font&gt; &lt;b&gt;External System&lt;/b&gt; (AutoEQ Repo / Android OS)&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:14px&quot;&gt;&amp;#8594;&lt;/font&gt; &lt;b&gt;Relationship&lt;/b&gt; [Protocol / Technology]&lt;br&gt;&lt;br&gt;&lt;i&gt;Runtime execution is 100% offline on Android (7-band EQ).&lt;/i&gt;" vertex="1">
          <mxGeometry height="230" width="360" x="1200" y="800" as="geometry" />
        </mxCell>
        <mxCell id="c1_edge_user_app" edge="1" parent="1" source="c1_user" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;strokeWidth=2;fontColor=#222222;labelBackgroundColor=#FFFFFF;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="c1_eqai_app" value="Selects headphones, adjusts 7-band manual EQ sliders,&lt;br&gt;or gives high-level AI sound instructions&lt;br&gt;(&amp;quot;More Bass&amp;quot;, &amp;quot;Richer Sound&amp;quot;)&lt;br&gt;&lt;b&gt;[Flutter Thin UI Shell / Material 3 / Riverpod]&lt;/b&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c1_edge_eng_ml" edge="1" parent="1" source="c1_engineer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;strokeWidth=2;fontColor=#222222;labelBackgroundColor=#FFFFFF;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="c1_ml_pipeline" value="Configures &amp;amp; runs dataset preparation (Parquet + HDF5),&lt;br&gt;TensorFlow/Keras training, validation, and INT8 export&lt;br&gt;&lt;b&gt;[Python CLI / MLflow]&lt;/b&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c1_edge_ml_autoeq" edge="1" parent="1" source="c1_ml_pipeline" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;strokeWidth=2;fontColor=#222222;labelBackgroundColor=#FFFFFF;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="c1_autoeq" value="Clones and parses ~4,000 headphone FR measurements&lt;br&gt;into Apache Parquet &amp;amp; HDF5&lt;br&gt;&lt;b&gt;[Git / Python CLI]&lt;/b&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c1_edge_ml_app" edge="1" parent="1" source="c1_ml_pipeline" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;strokeWidth=2;fontColor=#222222;labelBackgroundColor=#FFFFFF;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="c1_eqai_app" value="Packages quantized INT8 .tflite models (&amp;lt;1 MB)&lt;br&gt;&amp;amp; indexed SQLite AutoEQ DB&lt;br&gt;(FTS5 + FLOAT32 BLOBs) into app assets&lt;br&gt;&lt;b&gt;[Build-time Flutter Assets]&lt;/b&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c1_edge_app_audio" edge="1" parent="1" source="c1_eqai_app" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;strokeWidth=2;fontColor=#222222;labelBackgroundColor=#FFFFFF;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="c1_audio_sub" value="Rust Mathematical Engine calculates 7-band biquad filters,&lt;br&gt;smoothing &amp;amp; preamp, and directly invokes global system equalizer&lt;br&gt;&lt;b&gt;[Rust JNI (jni-rs) -&amp;gt; Android DynamicsProcessing API]&lt;/b&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c1_edge_bt_app" edge="1" parent="1" source="c1_bt_service" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;strokeWidth=2;fontColor=#222222;labelBackgroundColor=#FFFFFF;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="c1_eqai_app" value="Notifies headphone plug/unplug &amp;amp;&lt;br&gt;Bluetooth device name for&lt;br&gt;auto-profile switching&lt;br&gt;&lt;b&gt;[ACTION_HEADSET_PLUG /&lt;br&gt;Bluetooth Broadcasts]&lt;/b&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="c2-containers" name="C2 - Container Diagram">
    <mxGraphModel dx="1385" dy="761" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c2_title_banner" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#1E293B;align=left;spacingLeft=20;verticalAlign=middle;" value="&lt;b style=&quot;font-size:20px;&quot;&gt;EQAI — C2: Container Diagram&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#444444;&quot;&gt;Offline Intelligent 7-Band Parametric Equalizer for Android — Build-Time ML Pipeline &amp;amp; On-Device Intermediary Runtime Architecture&lt;/span&gt;" vertex="1">
          <mxGeometry height="65" width="1945" x="30" y="20" as="geometry" />
        </mxCell>
        <mxCell id="c2_boundary_pipeline" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#444444;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#222222;fontStyle=1;fontSize=14;" value="Offline ML &amp;amp; Data Pipeline (Build-Time)" vertex="1">
          <mxGeometry height="300" width="1225" x="350" y="110" as="geometry" />
        </mxCell>
        <mxCell id="c2_boundary_mobile" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#444444;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#222222;fontStyle=1;fontSize=14;" value="EQAI Mobile Application (Android Runtime)" vertex="1">
          <mxGeometry height="725" width="1225" x="350" y="470" as="geometry" />
        </mxCell>
        <mxCell id="c2_person_engineer" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;arcSize=10;fontSize=11;spacing=8;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;ML / Data Engineer&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Executes offline AutoEQ scraping, 512-pt preprocessing, neural network training, INT8 quantization, and asset bundling." vertex="1">
          <mxGeometry height="130" width="250" x="30" y="115" as="geometry" />
        </mxCell>
        <mxCell id="c2_ext_autoeq" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;arcSize=8;fontSize=11;spacing=8;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;AutoEQ GitHub Repository&lt;/b&gt;&lt;br&gt;&lt;i&gt;[External System: Git / CSV &amp;amp; JSON Dataset]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Open-source repository of ~4,000 measured headphone frequency response curves and reference targets." vertex="1">
          <mxGeometry height="135" width="250" x="30" y="275" as="geometry" />
        </mxCell>
        <mxCell id="c2_person_user" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;arcSize=10;fontSize=11;spacing=8;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Audiophile / Mobile User&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Selects headphone model (~4,000 models), adjusts 7-band manual EQ sliders or enters high-level AI sound instructions, and compares A/B profiles." vertex="1">
          <mxGeometry height="115" width="280" x="810" y="1265" as="geometry" />
        </mxCell>
        <mxCell id="c2_ext_dynamics" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;arcSize=8;fontSize=11;spacing=8;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Android OS DynamicsProcessing API&lt;/b&gt;&lt;br&gt;&lt;i&gt;[External System: android.media.audiofx.DynamicsProcessing (Global Session 0)]&lt;/i&gt;&lt;br&gt;&lt;br&gt;System audio server applying global 7-band parametric EQ and input preamp gain across all device playback." vertex="1">
          <mxGeometry height="155" width="250" x="1725" y="575" as="geometry" />
        </mxCell>
        <mxCell id="c2_ext_bluetooth" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;arcSize=8;fontSize=11;spacing=8;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Android OS Bluetooth &amp;amp; Broadcasts&lt;/b&gt;&lt;br&gt;&lt;i&gt;[External System: ACTION_HEADSET_PLUG &amp;amp; BluetoothAdapter]&lt;/i&gt;&lt;br&gt;&lt;br&gt;System broadcast service emitting wired headset plug/unplug and Bluetooth device connection events." vertex="1">
          <mxGeometry height="155" width="250" x="1725" y="965" as="geometry" />
        </mxCell>
        <mxCell id="c2_pipeline_scraper" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#FFFFFF;arcSize=8;fontSize=11;spacing=10;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;AutoEQ Scraper &amp;amp; Preprocessor&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Container: Python CLI, NumPy, SciPy, Apache Parquet, HDF5]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Parses ~4,000 headphone FR curves, exports intermediate catalog to Apache Parquet, interpolates to 512-point log grid (20-20,000 Hz), normalizes at 1 kHz, computes Harman 2019 correction targets, and saves training/val/test tensors in HDF5 (.h5)." vertex="1">
          <mxGeometry height="220" width="490" x="385" y="165" as="geometry" />
        </mxCell>
        <mxCell id="c2_pipeline_trainer" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#FFFFFF;arcSize=8;fontSize=11;spacing=10;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Neural Network Training &amp;amp; Quantization Engine&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Container: Python CLI, TensorFlow / Keras, MLflow]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Trains the 1D CNN Encoder + MLP Decoder (1024-pt input -&amp;gt; 7 biquad bands, 7x3 = 21 outputs) and Abstract Sound Tuning model (&amp;quot;More Bass&amp;quot;, &amp;quot;Richer Sound&amp;quot;); tracks runs in MLflow; applies native TensorFlow INT8 post-training quantization (&amp;lt;1 MB) and exports .tflite artifacts." vertex="1">
          <mxGeometry height="220" width="520" x="1025" y="165" as="geometry" />
        </mxCell>
        <mxCell id="c2_app_assets" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=11;spacing=8;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Bundled Asset Store (Read-Only)&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Container: Flutter Assets (SQLite FTS5 .db &amp;amp; INT8 .tflite)]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Pre-indexed SQLite (.db) database (~4,000 AutoEQ models with FTS5 search and 512-pt binary FLOAT32 BLOB curves), reference target curves (Harman 2019, Diffuse Field, Flat), and INT8 .tflite models (&amp;lt; 1 MB)." vertex="1">
          <mxGeometry height="220" width="255" x="365" y="530" as="geometry" />
        </mxCell>
        <mxCell id="c2_app_ml_worker" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2B6CB0;strokeColor=#1A4971;fontColor=#FFFFFF;arcSize=8;fontSize=11;spacing=8;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;On-Device AI Model (TFLite Worker)&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Container: Dart Background Isolate + tflite_flutter]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Executes INT8 .tflite inference off the UI thread for Headphone FR + Target FR and semantic instructions (&amp;quot;More Bass&amp;quot;, &amp;quot;Richer Sound&amp;quot;, &amp;quot;Warmth&amp;quot;, &amp;quot;Clarity&amp;quot;) to predict 7 biquad bands ([{freq, gain, Q}], 21 values) and forwards them directly to the Rust Mathematical Engine via flutter_rust_bridge (Dart FFI)." vertex="1">
          <mxGeometry height="225" width="300" x="775" y="530" as="geometry" />
        </mxCell>
        <mxCell id="c2_app_rust" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B45309;strokeColor=#78350F;fontColor=#FFFFFF;arcSize=8;fontSize=11;spacing=8;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Rust Mathematical Engine (Core Intermediary)&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Container: Rust Shared Library (libeqai_math.so — flutter_rust_bridge + jni-rs)]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Core intermediary receiving 7-band manual EQ from Flutter UI Shell and 7-band AI-predicted EQ from On-Device AI Model via flutter_rust_bridge; computes RBJ biquad math, crossfade smoothing &amp;amp; auto-preamp; returns 512-pt composite FR curve (dB) to Flutter UI Shell; and directly calls Android DynamicsProcessing sound methods via Rust JNI (jni-rs) on global sessionId = 0." vertex="1">
          <mxGeometry height="245" width="300" x="1255" y="530" as="geometry" />
        </mxCell>
        <mxCell id="c2_app_user_db" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=11;spacing=8;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Local User Database (Read-Write)&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Container: SQLite (drift / sqlite3)]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Relational SQLite database persisting user EQProfiles, Bluetooth device associations, cached 7-band inference results, and settings." vertex="1">
          <mxGeometry height="215" width="255" x="365" y="935" as="geometry" />
        </mxCell>
        <mxCell id="c2_app_flutter" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;arcSize=8;fontSize=11;spacing=8;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Flutter UI Shell&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Container: Flutter / Dart, Material 3, Riverpod, CustomPainter]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Thin UI shell rendering headphone search, 60fps log-scale 512-pt FR charts via Flutter CustomPainter, 7-band manual EQ controls, and high-level AI instruction controls (&amp;quot;More Bass&amp;quot;, &amp;quot;Richer Sound&amp;quot;, &amp;quot;Warmth&amp;quot;, &amp;quot;Clarity&amp;quot;). State managed via Riverpod; forwards manual EQ to Rust and AI instructions/FR to TFLite Isolate; handles local profile/asset selection &amp;amp; headset broadcasts via EventChannel." vertex="1">
          <mxGeometry height="235" width="350" x="775" y="925" as="geometry" />
        </mxCell>
        <mxCell id="c2_legend_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=10;fontColor=#1E293B;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Legend&lt;/b&gt;" vertex="1">
          <mxGeometry height="375" width="315" x="1660" y="110" as="geometry" />
        </mxCell>
        <mxCell id="c2_leg_person" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=11;" value="Person (User / Engineer)" vertex="1">
